#!/bin/bash

# simba:summary=Send the low battery warning notification and run battery-low hooks.
# simba:args=<percentage>
# simba:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: simba-battery-low <percentage>" >&2
  exit 1
fi

level=$1

simba-notification-send -g 󱐋 -u critical "Time to recharge!" "Battery is down to ${level}%" -i battery-caution -t 30000
simba-hook battery-low "$level"
