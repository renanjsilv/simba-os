#!/bin/bash

# simba:summary=Toggle microphone mute. Drives the hardware mic-mute LED on laptops that expose one.

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
  simba-brightness-keyboard-mute on
  simba-osd -i microphone-muted -m "Microphone muted"
else
  simba-brightness-keyboard-mute off
  simba-osd -i microphone -m "Microphone on"
fi
