#!/bin/bash

set -e

# Simba ships no default agent, so invite once rather than picking one. An
# agent already chosen means the invitation has nothing to offer.
if [[ -z $(simba-default-agent) ]] && simba-done ensure agent-setup-invitation; then
  simba-notification-send -u critical -g 󰚩 "Set your default agent" \
    "Let your favorite agent help with Simba." \
    --exec simba menu summon setup.default.agent
fi
