# Maintainer: drakkan <nicola.murino at gmail dot com>
# Maintainer: Chris Billington <chrisjbillington@gmail.com>
# Simba OS: a receita do AUR gera 9 pacotes (gtk, gnome-shell, sons, sessões…), mas o Simba
# só usa e publica o yaru-icon-theme. Gerar os 9 copiava a árvore de ícones (dezenas de
# milhares de arquivos) nove vezes e o makepkg passava minutos procurando binários para
# "strip" em cada cópia — a compilação parecia travada. Aqui: só os ícones, sem strip/debug
# (é um tema; não há binário nenhum).
pkgbase=yaru
pkgname=yaru-icon-theme
pkgver=26.10.3ubuntu
pkgrel=1
# epoch: o upstream alterna tags com e sem sufixo "ubuntu" (26.10.3 > 26.10.3ubuntu no vercmp)
# e o Omarchy publicou 26.10.3-3; sem epoch esta receita nunca atualiza quem veio de lá.
epoch=1
pkgdesc="Yaru default ubuntu icon theme"
arch=(any)
url="https://github.com/ubuntu/yaru"
license=('GPL3' 'CC-BY-SA-4.0')
depends=("hicolor-icon-theme" "gtk-update-icon-cache" "librsvg")
makedepends=('meson' 'sassc' 'git')
options=(!strip !debug)

source=("https://github.com/ubuntu/yaru/archive/${pkgver}.tar.gz")
sha256sums=('2418ac22adafc4e7027375f87f4c93d7e86215d125c62c37f97219e877604619')

build() {
  # gtk e ubuntu-unity entram só na compilação: o meson dos ícones usa as cores do gtk, e o
  # unity liga os ícones legacy/panel/animations (que o Simba usa); o pacote leva só ícones
  arch-meson $pkgbase-$pkgver build \
    -Dicons=true -Dgtk=true -Dgtksourceview=false -Dgnome-shell=false -Dsounds=false \
    -Dsessions=false -Dmetacity=false -Dubuntu-unity=true -Dxfwm4=false \
    -Dcinnamon=false -Dcinnamon-shell=false -Dmate=false -Dmate-dark=false
  ninja -C build
}

package() {
  DESTDIR="$pkgdir" ninja -C build install >/dev/null
  # só os ícones (o que sobrar de outros componentes fica de fora)
  find "$pkgdir/usr/share" -mindepth 1 -maxdepth 1 ! -name icons -exec rm -rf {} +
}
