#!/bin/bash

# simba:summary=Remove the GeForce NOW Flatpak app and its data.
# simba:group=remove
# simba:name=gaming geforce-now

set -e

if simba-cmd-present flatpak && flatpak info com.nvidia.geforcenow &>/dev/null; then
  flatpak uninstall -y --delete-data com.nvidia.geforcenow
fi

echo ""
echo "GeForce NOW removed."
