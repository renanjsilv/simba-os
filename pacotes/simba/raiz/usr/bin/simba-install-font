#!/bin/bash

# simba:summary=Install a Nerd Font package and switch the system to it
# simba:args=<display-name> <package> <family>
# simba:examples=simba install font 'Cascadia Mono' ttf-cascadia-mono-nerd 'CaskaydiaMono Nerd Font'

name="${1-}"
package="${2-}"
family="${3-}"

if [[ -z $name || -z $package || -z $family ]]; then
  echo "Usage: simba-install-font <display-name> <package> <family>" >&2
  exit 1
fi

printf -v install_message '%q' "Installing ${name}..."
printf -v package_arg '%q' "$package"
printf -v family_arg '%q' "$family"

exec simba-launch-floating-terminal-with-presentation \
  "echo ${install_message}; simba-pkg-add ${package_arg} && sleep 2 && simba-font-set ${family_arg}"
