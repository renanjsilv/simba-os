#!/usr/bin/env python3
"""simba-senha — pede a senha de administrador numa janela (askpass do sudo).

O sudo chama este programa quando precisa de senha e não há terminal (apps
gráficos, agentes de IA, scripts lançados pelo menu) ou com `sudo -A`. A senha
digitada vai só para o sudo, pela saída padrão; nada é guardado.

    SUDO_ASKPASS=/usr/bin/simba-senha   (definido pelo Simba na sessão)

A janela mostra QUEM pediu e O QUE vai rodar como administrador (lido do
processo do sudo), para a pessoa decidir com informação.
Saída 0 com a senha; 1 se cancelar.
"""
import os
from pathlib import Path
import re
import shlex
import sys

# Sem método de entrada (fcitx5/IBus) neste diálogo: com o fcitx5 no Wayland, o
# campo de senha do GTK4 travava depois do primeiro caractere. O contexto simples
# do GTK ainda trata acentos e teclas mortas (á, ç, ~). Tem que vir antes do Gtk.
os.environ["GTK_IM_MODULE"] = "gtk-im-context-simple"

import gi  # noqa: E402
gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk, Pango  # noqa: E402

sys.path.insert(0, "/usr/share/simba-apps/idiomas")
try:
    from simba_i18n import t as _t  # noqa: E402
except ImportError:
    def _t(texto, *a):
        return texto

NOMES = {
    "claude": "Claude Code",
    "codex": "Codex",
    "opencode": "OpenCode",
    "agy": "Antigravity",
    "antigravity": "Antigravity",
    "copilot": "GitHub Copilot",
    "cursor-agent": "Cursor",
    "cursor": "Cursor",
    "windsurf": "Windsurf",
    "aider": "Aider",
    "gemini": "Gemini",
    "grok": "Grok",
    "crush": "Crush",
    "pi": "Pi",
    "draco": "Draco",
    "pkexec": "pkexec",
    "code": "Visual Studio Code",
    "pamac": "Pamac",
    "pacman": "Pacman",
    "yay": "Yay",
    "simba": "Simba",
    "simba-apps": "Simba Apps",
    "simba-agentes": "Simba Agentes",
}

INTERPRETES = {
    "bash", "sh", "zsh", "fish", "python", "python3", "env",
    "node", "bun", "deno", "electron", "mise", "asdf", "sudo", "pkexec",
}


def _cmdline(pid):
    try:
        partes = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
        return [p.decode("utf-8", "replace") for p in partes if p]
    except OSError:
        return []


def _pai(pid):
    try:
        for linha in Path(f"/proc/{pid}/status").read_text().splitlines():
            if linha.startswith("PPid:"):
                return int(linha.split()[1])
    except (OSError, ValueError):
        pass
    return 0


def _normalizar_token(arg):
    if not arg or arg.startswith("-"):
        return ""
    return Path(Path(arg).name).stem.lower()


def _identificar_quem(args):
    candidatos = [_normalizar_token(a) for a in args[:4]]
    for c in candidatos:
        if c in NOMES:
            return NOMES[c]
    for c in candidatos:
        if c and c not in INTERPRETES and not c.startswith("python3."):
            return c
    return ""


def contexto():
    """(comando que o sudo vai rodar, programa que chamou o sudo)."""
    sudo = os.getppid()
    args = _cmdline(sudo)
    comando = ""
    if args and Path(args[0]).name == "sudo":
        resto = args[1:]
        # pula as opções do próprio sudo (-A, -E, -u usuário…)
        while resto and resto[0].startswith("-") and resto[0] != "--":
            opc = resto.pop(0)
            if opc in ("-u", "-g", "-C", "-D", "-h", "-p", "-r", "-t", "-U", "-T") and resto:
                resto.pop(0)
        if resto and resto[0] == "--":
            resto.pop(0)
        comando = shlex.join(resto) if resto else ""
    quem = ""
    pid = _pai(sudo)
    for _ in range(8):  # sobe a árvore até achar um programa conhecido
        if pid <= 1:
            break
        args = _cmdline(pid)
        if args:
            achado = _identificar_quem(args)
            if achado:
                if achado in NOMES.values():
                    quem = achado
                    break
                if not quem:
                    quem = achado
        pid = _pai(pid)
    return comando, quem


class Senha(Adw.Application):
    def __init__(self, prompt):
        super().__init__(application_id="com.simba.Senha", flags=Gio.ApplicationFlags.NON_UNIQUE)
        self.prompt = prompt
        self.resultado = None

    def do_activate(self):
        comando, quem = contexto()
        win = Adw.ApplicationWindow(application=self, title=_t("Senha de administrador"))
        win.set_default_size(460, -1)
        win.set_resizable(False)

        caixa = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        for lado in ("top", "bottom", "start", "end"):
            getattr(caixa, f"set_margin_{lado}")(22)

        icone = Gtk.Image.new_from_icon_name("dialog-password-symbolic")
        icone.set_pixel_size(40)
        icone.add_css_class("accent")
        caixa.append(icone)

        titulo = Gtk.Label(label=_t("Permissão de administrador"))
        titulo.add_css_class("title-2")
        caixa.append(titulo)

        quem_txt = (f"{quem} " + _t("quer executar como administrador:")) if quem else \
            _t("Um programa quer executar como administrador:")
        desc = Gtk.Label(label=quem_txt, wrap=True, justify=Gtk.Justification.CENTER)
        desc.add_css_class("dim-label")
        caixa.append(desc)

        if comando:
            cmd = Gtk.Label(label=comando, wrap=True, selectable=True, xalign=0)
            cmd.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
            cmd.add_css_class("monospace")
            for lado in ("top", "bottom", "start", "end"):
                getattr(cmd, f"set_margin_{lado}")(10)
            moldura = Gtk.Box()
            moldura.add_css_class("card")
            moldura.append(cmd)

            rolagem = Gtk.ScrolledWindow()
            rolagem.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            rolagem.set_max_content_height(140)
            rolagem.set_propagate_natural_height(True)
            rolagem.set_child(moldura)
            caixa.append(rolagem)

        teve_erro = bool(re.search(r"try again|tente novamente|incorret", self.prompt or "", re.I))
        if teve_erro:
            erro = Gtk.Label(label=_t("Senha incorreta. Tente novamente."))
            erro.add_css_class("error")
            caixa.append(erro)

        self.entrada = Gtk.PasswordEntry(show_peek_icon=True)
        if teve_erro:
            self.entrada.add_css_class("error")
        delegado = self.entrada.get_delegate()
        if delegado is not None:  # reforço, caso GTK_IM_MODULE seja ignorado
            delegado.set_property("im-module", "gtk-im-context-simple")
        self.entrada.set_property("placeholder-text", _t("Senha de %1").replace("%1", os.environ.get("USER", "")))
        self.entrada.connect("activate", lambda *_: self.confirmar(win))
        caixa.append(self.entrada)

        botoes = Gtk.Box(spacing=10, homogeneous=True)
        cancelar = Gtk.Button(label=_t("Cancelar"))
        cancelar.connect("clicked", lambda *_: win.close())
        ok = Gtk.Button(label=_t("Autorizar"))
        ok.add_css_class("suggested-action")
        ok.set_sensitive(False)
        ok.connect("clicked", lambda *_: self.confirmar(win))
        botoes.append(cancelar)
        botoes.append(ok)
        caixa.append(botoes)

        def _texto_mudou(*_):
            texto = self.entrada.get_text()
            ok.set_sensitive(bool(texto))
            if self.entrada.has_css_class("error"):
                self.entrada.remove_css_class("error")

        self.entrada.connect("notify::text", _texto_mudou)

        tecla = Gtk.EventControllerKey()
        tecla.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        tecla.connect("key-pressed", self.tecla_pressionada, win)
        win.add_controller(tecla)

        win.set_content(caixa)
        win.connect("notify::is-active",
                    lambda w, _p: self.entrada.grab_focus() if w.is_active() else None)
        win.present()
        # idle_add de foco UMA vez. Antes a função devolvia True (o de grab_focus),
        # então o idle se repetia sem parar: janela a 100% de CPU e teclas perdidas.
        GLib.idle_add(self.focar_entrada)

    def focar_entrada(self):
        self.entrada.grab_focus()
        return False

    def entrada_tem_foco(self):
        # No GtkPasswordEntry quem recebe o foco de verdade é o GtkText interno
        # (o delegado); has_focus() na entrada fica False.
        delegado = self.entrada.get_delegate()
        return bool(delegado is not None and delegado.has_focus()) or self.entrada.has_focus()

    def tecla_pressionada(self, _controle, chave, _codigo, estado, win):
        if chave == Gdk.KEY_Escape:
            win.close()
            return True
        if self.entrada_tem_foco():
            return False  # caminho normal do GTK
        # A entrada perdeu o foco (troca de janela, foco do gerenciador…). Devolve
        # o foco e entrega esta tecla, para não perder o que a pessoa digitou.
        self.entrada.grab_focus()
        if chave == Gdk.KEY_BackSpace:
            pos = self.entrada.get_position()
            if pos > 0:
                self.entrada.delete_text(pos - 1, pos)
            return True
        if chave in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            self.confirmar(win)
            return True
        if estado & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.ALT_MASK |
                     Gdk.ModifierType.SUPER_MASK):
            return False
        codigo = Gdk.keyval_to_unicode(chave)
        if codigo:
            self.entrada.insert_text(chr(codigo), -1)
            self.entrada.set_position(-1)
            return True
        return False

    def confirmar(self, win):
        texto = self.entrada.get_text()
        if not texto:
            return
        self.resultado = texto
        win.close()


def main():
    prompt = " ".join(sys.argv[1:])
    app = Senha(prompt)
    app.run([sys.argv[0]])
    if app.resultado is None:
        return 1
    sys.stdout.write(app.resultado + "\n")
    sys.stdout.flush()
    return 0


if __name__ == "__main__":
    sys.exit(main())
