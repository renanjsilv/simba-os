#!/bin/bash

# simba:summary=Enable, disable, toggle, or recover mirroring the internal display to an external monitor
# simba:args=<on|off|toggle|recover>

TOGGLE="internal-monitor-mirror"
TOGGLE_FLAG="$HOME/.local/state/simba/toggles/hypr/$TOGGLE.lua"
DISABLE_TOGGLE="internal-monitor-disable"

INTERNAL=$(simba-hyprland-monitor-laptop)
# The first active external monitor
EXTERNAL=$(hyprctl monitors -j | jq -r '.[] | select(.name | test("^(eDP|LVDS|DSI)-") | not).name' | head -n 1)

on() {
  if [[ -z $EXTERNAL ]]; then
    simba-notification-send -g 󰍹 "Nenhum monitor externo encontrado para espelhar"
    exit 1
  fi

  if [[ -z $INTERNAL ]]; then
    simba-notification-send -g 󰍹 "Nenhuma tela de notebook encontrada para espelhar"
    exit 1
  fi

  # Both names are written into generated Lua below, so only plain connector
  # names may pass; a user-created headless output can carry any name.
  for output in "$INTERNAL" "$EXTERNAL"; do
    if [[ ! $output =~ ^[A-Za-z0-9._-]+$ ]]; then
      simba-notification-send -g 󰍹 "Nome de monitor inseguro recusado"
      exit 1
    fi
  done

  simba-hyprland-toggle $DISABLE_TOGGLE off

  if simba-hyprland-toggle-disabled $TOGGLE; then
    printf 'hl.monitor({ output = "%s", mode = "preferred", position = "auto", scale = 1, mirror = "%s" })\n' "$EXTERNAL" "$INTERNAL" >"$TOGGLE_FLAG"
    simba-notification-send -g 󰍹 "Espelhamento ativado ($EXTERNAL)"
    hyprctl reload
  fi
}

off() {
  if simba-hyprland-toggle-enabled $TOGGLE; then
    simba-hyprland-toggle $TOGGLE off
    simba-notification-send -g 󰍹 "Modo estendido restaurado"
  fi
}

toggle() {
  if simba-hyprland-toggle-enabled $TOGGLE; then
    off
  else
    on
  fi
}

recover() {
  if ! simba-hyprland-monitor-external-active && simba-hyprland-toggle-enabled $TOGGLE; then
    simba-hyprland-toggle $TOGGLE off
  fi
}

case "$1" in
  on) on ;;
  off) off ;;
  toggle) toggle ;;
  recover) recover ;;
  *)
    echo "Usage: $(basename "$0") {on|off|toggle|recover}" >&2
    exit 1
    ;;
esac
