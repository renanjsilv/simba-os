#!/bin/bash

# simba:summary=Overwrite the user config for the Plymouth drive decryption and boot sequence with the Simba default and rebuild it.
# simba:requires-sudo=true

# Reuse the fixed-file publisher so root never resolves the source checkout or
# follows a destination symlink while restoring the packaged assets.
exec "$SIMBA_PATH/bin/simba-plymouth-set" --refresh-default
