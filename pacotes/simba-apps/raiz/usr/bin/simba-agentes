#!/bin/bash
# Agentes de IA do Simba OS (Frontend unificado GTK4/libadwaita).

# Já aberto: traz a janela para a área de trabalho atual e foca.
info=$(hyprctl clients -j 2>/dev/null | jq -r '.[] | select(.class=="com.simba.Agentes") | "\(.address) \(.workspace.name)"' | head -1)
if [[ -n $info ]]; then
  read -r addr ws <<<"$info"
  atual=$(hyprctl activeworkspace -j 2>/dev/null | jq -r .name)
  [[ -n $atual && $ws != "$atual" ]] && hyprctl dispatch "hl.dsp.window.move({ workspace = \"$atual\", follow = false, window = \"address:$addr\" })" >/dev/null 2>&1
  hyprctl dispatch "foco.janela(\"$addr\")" >/dev/null 2>&1
  exit 0
fi

exec /usr/bin/python3 /usr/share/simba-apps/agentes/app.py "$@"
