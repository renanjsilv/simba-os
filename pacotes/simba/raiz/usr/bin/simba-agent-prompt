#!/bin/bash

# simba:summary=Launch the default coding agent with a prompt
# simba:args=[--inline] <prompt...>
# simba:examples=simba agent prompt "Review this project"

# Prompts live here rather than on `simba agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

inline=()
if [[ ${1:-} == "--inline" ]]; then
  inline=(--inline)
  shift
fi

if (($# == 0)); then
  echo "Usage: simba agent prompt [--inline] <prompt...>" >&2
  exit 1
fi

exec simba-agent "${inline[@]}" --prompt "$*"
