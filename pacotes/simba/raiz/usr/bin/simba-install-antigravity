#!/bin/bash

# simba:summary=Install Antigravity CLI
# simba:args=<--check|--now>

set -euo pipefail
mode=${1:-}

if [[ $mode == "--check" ]]; then
  [[ -x $HOME/.local/bin/agy ]] && exit 0 || exit 1
elif [[ $mode == "--now" ]]; then
  echo "Installing Antigravity..."
  curl -fsSL https://antigravity.google/cli/install.sh | bash
  [[ -x $HOME/.local/bin/agy ]] && exit 0 || exit 1
else
  echo "Usage: simba-install-antigravity <--check|--now>" >&2
  exit 1
fi
