# Single source of truth for SIMBA_PATH + PATH adjustments. Sourced by:
#   /etc/profile.d/simba.sh                 (system login shells)
#   /etc/skel/.bashrc                         (interactive shells)
#   /usr/share/uwsm/env.d/10-simba          (Hyprland session via uwsm)
#   /usr/share/simba/default/bash/envs      (bash rc chain; SSH/non-login)

# /etc/simba.conf is written by simba-dev-link and reset by
# simba-dev-unlink. When absent, force the packaged default instead of
# preserving a stale inherited value.
if [ -f /etc/simba.conf ]; then
  . /etc/simba.conf
  : "${SIMBA_PATH:=/usr/share/simba}"
else
  SIMBA_PATH=/usr/share/simba
fi
export SIMBA_PATH

# Only prepend in dev-link mode. On a production install, the binaries are
# already on PATH as /usr/bin/simba-* via the simba package — prepending
# /usr/share/simba/bin would just be noise.
if [ "$SIMBA_PATH" != /usr/share/simba ]; then
  case ":$PATH:" in
    *":${SIMBA_PATH%/}/bin:"*) ;;
    *) PATH="${SIMBA_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
fi

# User-level tool paths, appended so system binaries keep precedence. This is
# what lets login shells (ssh, bash -lc) and the uwsm session find mise-managed
# tools without an interactive rc. Keep these directories in sync with the PAM
# PATH line from install/config/ssh-command-path.sh, which covers SSH commands
# that run no shell setup at all.
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/share/mise/shims" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/bin" ;;
esac
export PATH
