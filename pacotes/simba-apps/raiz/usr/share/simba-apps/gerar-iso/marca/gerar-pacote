#!/bin/bash
# Gera o pacote de identidade visual de uma ISO distribuível.
#   gerar-pacote "<nome>" <estilo> <pasta-de-saída>
# Estilo: pixel (o retrato da marca em pixel art, /usr/share/simba-apps/marca-pixel).
# Saída: logo.png, logo-nome.png (tela de inicialização), papel-de-parede.png,
#        icone.png (botão Iniciar), marca.env
set -euo pipefail
HOME_DONO=$(cd "$(dirname "$0")/../../../.." && pwd)   # ~/.local/share/gerar-iso/marca → ~
nome=${1:?nome} estilo=${2:-pixel} out=${3:?saída}
mkdir -p "$out"
# Só existe um desenho do Simba: o retrato em pixel art (marca-pixel). Estilos antigos
# (tinta, gravura, caricatura…) viram "pixel".
[ "$estilo" = pixel ] || { echo "aviso: estilo '$estilo' foi removido; usando pixel" >&2; estilo=pixel; }
cab=/usr/share/simba-apps/marca-pixel/retrato-1152.png claro=0
if [ "$claro" = 1 ]; then tinta='#111111' fundo='#f4f4f2' fundo2='#d9d9d6'; else tinta='#ffffff' fundo='#000000' fundo2='#000000'; fi
NOME_MAIUSC=$(printf '%s' "$nome" | tr '[:lower:]' '[:upper:]')
NOME_XML=$(printf '%s' "$NOME_MAIUSC" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')

PIX=/usr/share/simba-apps/marca-pixel
# outro nome que não "Simba OS": o retrato com o nome escrito na fonte normal (caminho de baixo)
if [ "$estilo" = pixel ] && [ "$NOME_MAIUSC" = "SIMBA OS" ]; then
  # tudo em múltiplos exatos dos pixels do desenho (ampliar com -scale, nunca suavizar)
  cp "$PIX/retrato-1152.png" "$out/logo.png"
  magick "$PIX/assinatura-escuro-1x.png" -scale 600% "PNG32:$out/logo-nome.png"
  magick "$PIX/assinatura-escuro-1x.png" -scale 400% "PNG32:$out/nome.png"
  magick -size 2560x1440 radial-gradient:'#1c1c1e'-'#050505' \
    \( "$PIX/retrato.png" -scale 3200% -channel A -evaluate multiply 0.10 +channel \) -gravity center -geometry +560+40 -composite \
    \( "$out/nome.png" -channel A -evaluate multiply 0.60 +channel \) -gravity southwest -geometry +120+110 -composite \
    -strip "$out/papel-de-parede.png"
  cp "$PIX/icone-256.png" "$out/icone.png"
else
magick "$cab" -trim +repage -resize 1024x1024 "PNG32:$out/logo.png"
magick -background none pango:"<span foreground='$tinta' font_desc='Adwaita Sans Heavy 70' letter_spacing='22000'>$NOME_XML</span>" \
  -trim +repage "$out/nome.png"
# logo + nome (transparente), proporção da prévia aprovada
magick "$out/logo.png" -resize 820x660 "$out/cab.tmp.png"
h=$(magick identify -format %h "$out/cab.tmp.png")
magick -size 900x$((h + 130)) xc:none "$out/cab.tmp.png" -gravity north -composite \
  \( "$out/nome.png" -resize 470x \) -gravity south -composite -trim +repage "PNG32:$out/logo-nome.png"
# papel de parede 2560x1440: degradê, o gato grande e discreto, o nome no canto
magick -size 2560x1440 radial-gradient:"$fundo"-"$fundo2" \
  \( "$out/logo.png" -resize 1200x1040 -channel A -evaluate multiply 0.10 +channel \) -gravity center -geometry +500+50 -composite \
  \( "$out/nome.png" -resize 400x -channel A -evaluate multiply 0.55 +channel \) -gravity southwest -geometry +120+110 -composite \
  -strip "$out/papel-de-parede.png"
magick "$out/logo.png" -resize 256x256 "PNG32:$out/icone.png"
fi
# gerador da tela de inicialização (vai junto: o do sistema clonado pode ser mais antigo)
install -d "$out/temas-boot"
install -m755 /usr/share/simba-apps/temas-boot/gerar "$out/temas-boot/gerar"
install -m644 /usr/share/simba-apps/temas-boot/tema.script "$out/temas-boot/tema.script"
install -m644 /usr/share/simba-apps/simba-simbolo.svg "$out/temas-boot/simba-simbolo.svg"
cp -r "$PIX" "$out/temas-boot/marca-pixel"

# mini game do instalador (corre em paralelo com o progresso no pendrive)
# O binário só existe no pacote instalado (compilado no PKGBUILD); montando a partir do
# repositório (iso/construir) compila aqui mesmo. Sem jogo a ISO NÃO sai: o mesmo programa
# desenha o logo nas telas do instalador (antes ele faltava em silêncio na ISO por receita).
DIR_GERAR="$(cd "$(dirname "$0")/.." && pwd)"
jogo=""
if [ -f "$DIR_GERAR/jogo/simba-jogo.c" ] && command -v gcc >/dev/null; then
  gcc -O2 -static -o "$out/jogo" "$DIR_GERAR/jogo/simba-jogo.c" && jogo="$out/jogo"
fi
if [ -z "$jogo" ]; then
  for j in "$DIR_GERAR/simba-jogo-telhados" /usr/share/simba-apps/gerar-iso/simba-jogo-telhados; do
    [ -x "$j" ] && { install -m755 "$j" "$out/jogo"; jogo="$out/jogo"; break; }
  done
fi
[ -n "$jogo" ] || { echo "gerar-pacote: mini game não encontrado nem compilado (precisa de gcc ou do simba-apps)" >&2; exit 1; }
rm -f "$out/cab.tmp.png"
cat > "$out/marca.env" <<ENV
NOME='${nome//\'/}'
ESTILO='$estilo'
CLARO=$claro
ENV
echo "$out"
