{
  "manifest_version": 3,
  "name": "Definir como papel de parede",
  "version": "1.5",
  "key": "",
  "permissions": [
    "contextMenus",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background-v5.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://photos.google.com/*"
      ],
      "js": [
        "photos.js"
      ],
      "all_frames": false,
      "run_at": "document_start"
    }
  ]
}