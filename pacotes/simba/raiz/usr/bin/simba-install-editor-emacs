#!/bin/bash

# simba:summary=Install Emacs with Simba theme and font integration via the simba-emacs AUR package

echo "Installing Emacs..."
simba-pkg-aur-add simba-emacs && simba-install-emacs

# emacsclient opens a frame on the running daemon, not a second Emacs
setsid uwsm-app -- gtk-launch emacsclient >/dev/null 2>&1 &
