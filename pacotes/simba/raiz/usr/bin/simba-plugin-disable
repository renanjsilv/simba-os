#!/bin/bash

# simba:summary=Disable a shell plugin
# simba:group=plugin
# simba:args=<id>

set -euo pipefail

fail() {
  echo "simba-plugin-disable: $*" >&2
  exit 1
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  echo "Usage: simba plugin disable <id>"
  exit 0
fi

id="${1:-}"
[[ -n $id ]] || fail "plugin id is required"

result=$(simba-shell shell setPluginEnabled "$id" false)
[[ $result == "ok" ]] ||
  fail "plugin '$id' is not known; run: simba-shell shell rescanPlugins"

echo "Disabled $id"
