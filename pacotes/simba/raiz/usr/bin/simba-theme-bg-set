#!/bin/bash

# simba:summary=Set the current background image
# simba:args=<path-to-image>
# simba:examples=simba theme bg set ~/Pictures/background.png

if [[ -z $1 ]]; then
  echo "Usage: simba-theme-bg-set <path-to-image>" >&2
  exit 1
fi

BACKGROUND="$(realpath "$1")"
CURRENT_BACKGROUND_LINK="$HOME/.local/state/simba/current/background"

if [[ ! -f $BACKGROUND ]]; then
  echo "File does not exist: $BACKGROUND" >&2
  exit 1
fi

# Create symlink to the new background
ln -nsf "$BACKGROUND" "$CURRENT_BACKGROUND_LINK"

# Lembra a escolha: simba-theme-set mantém este papel ao trocar de tema.
mkdir -p "$HOME/.local/state/simba"
printf '%s\n' "$BACKGROUND" >"$HOME/.local/state/simba/papel-definido"

# Update the live shell background immediately when it is running. The
# background plugin also polls this symlink, but IPC avoids the visible delay.
simba-shell -q background set "$BACKGROUND"
