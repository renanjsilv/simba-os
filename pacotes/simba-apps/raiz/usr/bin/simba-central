#!/bin/bash
# simba-central — ajudante da Central de controle (barra › ícones de rede/som/bateria).
#   simba-central estado               JSON com o estado de todos os botões e controles
#   simba-central wifi|bluetooth|naoperturbe|escuro|luznoturna|economia   liga/desliga
#   simba-central volume <0-100> | brilho <1-100> | mudo
#   simba-central chamada              JSON da chamada no navegador (navegador gravando o microfone)
#   simba-central chamada-mudo         liga/desliga o mudo do microfone só dessa chamada
#   simba-central chamada-abrir        traz a janela da chamada para a frente
set -uo pipefail

wifi_on()  { [[ $(nmcli -t -f WIFI g 2>/dev/null) == enabled ]]; }
bt_on()    { bluetoothctl show 2>/dev/null | grep -q 'Powered: yes'; }
dnd_on()   { [[ $(simba-shell notifications isDnd 2>/dev/null) =~ ^(on|true)$ ]]; }
tema()     { cat "$HOME/.local/state/simba/current/theme.name" 2>/dev/null; }
luz_on()   { local t; t=$(hyprctl hyprsunset temperature 2>/dev/null | grep -oE '[0-9]+' | head -1); [[ -n $t ]] && ((t < 6000)); }
perfil()   { powerprofilesctl get 2>/dev/null; }
b() { "$@" && echo true || echo false; }

saidas_audio() {
  python3 -c '
import subprocess, re, json
def get_sinks():
    try:
        def_sink = subprocess.check_output(["pactl", "get-default-sink"], text=True).strip()
    except Exception:
        def_sink = ""
    try:
        raw = subprocess.check_output(["pactl", "list", "sinks"], text=True)
    except Exception:
        return []
    sinks = []
    blocks = raw.split("Sink #")
    for b in blocks[1:]:
        name_m = re.search(r"^\s*Name:\s*(.+)$", b, re.M)
        desc_m = re.search(r"^\s*Description:\s*(.+)$", b, re.M)
        obj_m = re.search(r"^\s*object\.id\s*=\s*\"?(\d+)\"?", b, re.M)
        bus_m = re.search(r"^\s*device\.bus\s*=\s*\"?([^\s\"]+)\"?", b, re.M)
        form_m = re.search(r"^\s*device\.form_factor\s*=\s*\"?([^\s\"]+)\"?", b, re.M)
        if not name_m:
            continue
        name = name_m.group(1).strip()
        desc = desc_m.group(1).strip() if desc_m else name
        oid = int(obj_m.group(1)) if obj_m else 0
        bus = bus_m.group(1).lower() if bus_m else ""
        form = form_m.group(1).lower() if form_m else ""
        text_all = (name + " " + desc + " " + bus + " " + form).lower()
        if "bluetooth" in bus or "bluez" in text_all:
            tipo = "bluetooth"
        elif "headphone" in text_all or "headset" in text_all or "fone" in text_all:
            tipo = "headphones"
        elif "hdmi" in text_all or "displayport" in text_all:
            tipo = "hdmi"
        else:
            tipo = "speaker"
        sinks.append({
            "id": oid,
            "nome": name,
            "descricao": desc,
            "tipo": tipo,
            "padrao": (name == def_sink)
        })
    return sinks
print(json.dumps(get_sinks(), ensure_ascii=False))
' 2>/dev/null || echo '[]'
}

estado() {
  local ssid vol mudo bri bmax bat carregando claro saidas
  ssid=$(nmcli -t -f NAME,TYPE connection show --active 2>/dev/null | awk -F: '$2=="802-11-wireless"{print $1; exit}')
  read -r vol mudo < <(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '{printf "%d %s\n", $2*100+0.5, ($3=="[MUTED]")?"true":"false"}')
  bri=$(brightnessctl -m 2>/dev/null | head -1 | cut -d, -f4 | tr -d %)
  bat=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -1)
  carregando=$(grep -qx -e Charging -e Full /sys/class/power_supply/BAT*/status 2>/dev/null && echo true || echo false)
  claro=$(python3 -c "import re,sys
t=open('$HOME/.local/state/simba/current/theme/colors.toml').read()
m=re.search(r'^\s*background\s*=\s*[\"\']?#([0-9a-fA-F]{6})',t,re.M)
h=m.group(1) if m else '000000'; r,g,b=(int(h[i:i+2],16)/255 for i in (0,2,4))
print('true' if .2126*r+.7152*g+.0722*b>.5 else 'false')" 2>/dev/null || echo false)
  saidas=$(saidas_audio)
  jq -cn --argjson wifi "$(b wifi_on)" --arg ssid "$ssid" --argjson bt "$(b bt_on)" \
    --argjson dnd "$(b dnd_on)" --argjson claro "$claro" --argjson luz "$(b luz_on)" \
    --arg perfil "$(perfil)" --argjson vol "${vol:-0}" --argjson mudo "${mudo:-false}" \
    --argjson bri "${bri:-0}" --argjson bat "${bat:-null}" --argjson carregando "$carregando" \
    --argjson saidas "$saidas" \
    '{wifi:$wifi, ssid:$ssid, bluetooth:$bt, naoperturbe:$dnd, claro:$claro, luznoturna:$luz,
      economia:($perfil=="power-saver"), perfil:$perfil, volume:$vol, mudo:$mudo, brilho:$bri,
      bateria:$bat, carregando:$carregando, saidas_audio:$saidas}'
}

# Chamada de vídeo pelo navegador (Meet, Teams, Zoom, Discord…): um navegador com um fluxo de
# captura de áudio no PipeWire. O nome da plataforma vem do título da janela do navegador.
chamada() {
  local janelas
  janelas=$(hyprctl clients -j 2>/dev/null || echo '[]')
  pw-dump 2>/dev/null | JANELAS="$janelas" python3 -c '
import json, os, re, sys
NAVEGADORES = re.compile(r"^(brave|brave-browser|chrome|chromium|google-chrome.*|firefox.*|librewolf|zen|msedge|microsoft-edge.*|vivaldi.*|opera.*)$", re.I)
PLATAFORMAS = [(r"\bMeet\b|meet\.google", "Google Meet"), (r"Teams", "Microsoft Teams"), (r"Zoom", "Zoom"),
               (r"Discord", "Discord"), (r"Jitsi", "Jitsi Meet"), (r"WhatsApp", "WhatsApp"), (r"Slack", "Slack"),
               (r"Webex", "Webex"), (r"Whereby", "Whereby"), (r"Skype", "Skype"), (r"Telegram", "Telegram")]
try:
    objs = json.load(sys.stdin)
except Exception:
    objs = []
clientes = {o["id"]: ((o.get("info") or {}).get("props") or {}) for o in objs if o.get("type") == "PipeWire:Interface:Client"}
fluxos = []
for o in objs:
    p = (o.get("info") or {}).get("props") or {}
    if o.get("type") != "PipeWire:Interface:Node" or p.get("media.class") != "Stream/Input/Audio":
        continue
    cli = clientes.get(p.get("client.id"), {})   # clientes do pipewire-pulse: o binário fica no cliente
    binario = os.path.basename(str(p.get("application.process.binary") or cli.get("application.process.binary") or ""))
    if not NAVEGADORES.match(binario):
        continue
    props = ((o.get("info") or {}).get("params") or {}).get("Props") or [{}]
    fluxos.append({"id": o["id"], "binario": binario, "mudo": bool(props[0].get("mute", False))})
# microfone desligado na própria chamada (Meet etc.): o navegador para de gravar, mas o cliente
# de entrada dele ("Brave input") continua conectado. Vale como chamada se houver janela de chamada.
entrada = any(NAVEGADORES.match(os.path.basename(str(c.get("application.process.binary") or "")))
              and re.search(r"input", str(c.get("application.name") or ""), re.I) for c in clientes.values())
saida = {"ativa": False}
if fluxos or entrada:
    saida.update(ids=[f["id"] for f in fluxos], controle=bool(fluxos),
                 mudo=all(f["mudo"] for f in fluxos) if fluxos else True, plataforma="", titulo="", janela="")
    try:
        janelas = json.loads(os.environ.get("JANELAS") or "[]")
    except Exception:
        janelas = []
    nav = [j for j in janelas if re.search(r"brave|chrom|firefox|librewolf|zen|edge|vivaldi|opera", (j.get("class") or ""), re.I)]
    escolha = None
    for j in nav:
        for padrao, nome in PLATAFORMAS:
            # sites de chat ficam abertos o dia todo: só contam gravando o microfone de fato
            if nome in ("Discord", "WhatsApp", "Slack", "Telegram") and not fluxos:
                continue
            if re.search(padrao, j.get("title") or ""):
                escolha = (j, nome); break
        if escolha: break
    if escolha:
        saida.update(ativa=True, plataforma=escolha[1], titulo=escolha[0].get("title", ""), janela=escolha[0].get("address", ""))
    elif fluxos:   # gravando o microfone, mas o título não diz de onde
        saida.update(ativa=True, titulo=nav[0].get("title", "") if nav else "", janela=nav[0].get("address", "") if nav else "")
    if not saida["ativa"]:
        saida = {"ativa": False}
print(json.dumps(saida, ensure_ascii=False))
'
}

case "${1:-}" in
  estado) estado ;;
  saidas-audio) saidas_audio ;;
  saida-audio)
    id=${2:-}
    nome=${3:-}
    if [[ -n $id && -n $nome ]]; then
      simba-audio-output-set-default "$id" "$nome" >/dev/null 2>&1 || wpctl set-default "$id" 2>/dev/null || pactl set-default-sink "$nome" 2>/dev/null || true
    elif [[ -n $id ]]; then
      wpctl set-default "$id" 2>/dev/null || true
    elif [[ -n $nome ]]; then
      pactl set-default-sink "$nome" 2>/dev/null || true
    fi ;;
  chamada) chamada ;;
  chamada-mudo)
    c=$(chamada); [[ $(jq -r .ativa <<<"$c") == true ]] || exit 0
    alvo=$([[ $(jq -r .mudo <<<"$c") == true ]] && echo 0 || echo 1)
    for id in $(jq -r '.ids[]' <<<"$c"); do wpctl set-mute "$id" "$alvo"; done ;;
  chamada-abrir)
    j=$(chamada | jq -r '.janela // empty'); [[ -n $j ]] && hyprctl dispatch "hl.dsp.focus({ window = \"address:$j\" })" >/dev/null ;;
  wifi) if wifi_on; then nmcli radio wifi off; else nmcli radio wifi on; fi ;;
  bluetooth) if bt_on; then bluetoothctl power off >/dev/null; else rfkill unblock bluetooth 2>/dev/null; bluetoothctl power on >/dev/null; fi ;;
  naoperturbe) simba-shell notifications toggleDnd >/dev/null ;;
  escuro)
    # alterna entre o tema escuro e o claro do Simba (black ⇄ white),
    # lembrando o último escuro/claro usado se for outro
    st="$HOME/.local/state/simba"; mkdir -p "$st"; t=$(tema)
    if [[ $(estado | jq -r .claro) == true ]]; then
      echo "$t" > "$st/tema-claro"; alvo=$(cat "$st/tema-escuro" 2>/dev/null || echo black)
    else
      echo "$t" > "$st/tema-escuro"; alvo=$(cat "$st/tema-claro" 2>/dev/null || echo white)
    fi
    setsid -f simba-theme-set "$alvo" >/dev/null 2>&1 ;;
  luznoturna) simba-toggle-nightlight >/dev/null 2>&1 ;;
  economia) if [[ $(perfil) == power-saver ]]; then powerprofilesctl set balanced; else powerprofilesctl set power-saver; fi ;;
  volume) wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume @DEFAULT_AUDIO_SINK@ "$(( ${2:-50} ))%" ;;
  mudo) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
  brilho) brightnessctl -q set "$(( ${2:-50} < 1 ? 1 : ${2:-50} ))%" ;;
  *) sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
