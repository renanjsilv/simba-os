#!/usr/bin/python3
# simba:summary=Print the GitHub Copilot usage record as JSON
# simba:args=[--force] [--limits-only]
# simba:hidden=true
"""Collect GitHub Copilot usage into one display-ready JSON record."""
from __future__ import annotations

import argparse
import json
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any

AGENT_ID = "copilot"
AGENT_NAME = "GitHub Copilot"


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--limits-only", action="store_true")
    args = parser.parse_args()

    root = Path.home() / ".copilot" / "session-state"
    today = datetime.now().date()
    recent_dates = [(today - timedelta(days=o)).isoformat() for o in range(6, -1, -1)]
    recent = {d: 0 for d in recent_dates}
    active: set[str] = set()
    total_sessions = 0
    total_prompts = 0
    today_prompts = 0
    today_sessions = 0
    total_tokens = 0
    today_tokens = 0
    model_usage: dict[str, dict[str, int]] = {}

    if root.is_dir():
        for f in root.rglob("events.jsonl"):
            total_sessions += 1
            day = None
            try:
                day = datetime.fromtimestamp(f.stat().st_mtime).date().isoformat()
            except OSError:
                day = today.isoformat()
            active.add(day)
            prompts_here = 0
            try:
                for line in f.read_text(errors="replace").splitlines():
                    try:
                        ev = json.loads(line)
                    except Exception:
                        continue
                    if ev.get("type") == "user.message":
                        prompts_here += 1
                    if ev.get("type") == "session.usage_record":
                        u = (ev.get("data") or {}).get("usage") or {}
                        inp = int(u.get("inputTokens") or 0)
                        out = int(u.get("outputTokens") or 0)
                        cache = int(u.get("cacheReadTokens") or 0)
                        total = inp + out + cache
                        model = str(u.get("model") or "copilot")
                        bucket = model_usage.setdefault(model, {"inputTokens": 0, "outputTokens": 0, "cacheReadInputTokens": 0, "cacheCreationInputTokens": 0})
                        bucket["inputTokens"] += inp
                        bucket["outputTokens"] += out
                        bucket["cacheReadInputTokens"] += cache
                        total_tokens += total
                        if day == today.isoformat():
                            today_tokens += total
            except OSError:
                pass
            if prompts_here <= 0:
                prompts_here = 1
            total_prompts += prompts_here
            if day in recent:
                recent[day] += prompts_here
            if day == today.isoformat():
                today_prompts += prompts_here
                today_sessions += 1

    record = {
        "schemaVersion": 1,
        "id": AGENT_ID,
        "name": AGENT_NAME,
        "updatedAt": datetime.now(timezone.utc).isoformat(),
        "ready": total_sessions > 0,
        "hasLocalStats": True,
        "tierLabel": "",
        "usageStatusText": "",
        "authHelpText": "",
        "limits": [],
        "todayPrompts": today_prompts,
        "todaySessions": today_sessions,
        "todayTotalTokens": today_tokens,
        "todayTokensByModel": {},
        "recentDays": [{"date": d, "messageCount": recent[d]} for d in recent_dates],
        "totalPrompts": total_prompts,
        "totalSessions": total_sessions,
        "activeDays": len(active),
        "activeDates": sorted(active),
        "modelUsage": model_usage,
    }
    print(json.dumps(record, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
