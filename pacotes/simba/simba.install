# Simba OS — scriptlet do pacote base.

# O 50-simba.preset pede fstrim.timer e paccache.timer, mas o Arch não aplica presets ao
# atualizar: instalações anteriores a 1.1.9-26 ficaram com os dois desligados (cache do
# pacman sem limite, SSD sem TRIM periódico). Liga uma vez só, na passagem por esta versão;
# quem desligar depois não é religado.
post_install() {
  glib-compile-schemas /usr/share/glib-2.0/schemas/ >/dev/null 2>&1 || true
}

post_upgrade() {
  glib-compile-schemas /usr/share/glib-2.0/schemas/ >/dev/null 2>&1 || true
  if (( $(vercmp "$2" 1.1.9-26) < 0 )); then
    systemctl enable fstrim.timer paccache.timer >/dev/null 2>&1 || true
    if [ -d /run/systemd/system ]; then
      systemctl start fstrim.timer paccache.timer >/dev/null 2>&1 || true
    fi
  fi
  # simba-wifi-vigia saiu (1.1.9-31): tirava o sintoma (Wi-Fi sem IPv4 após o band steering do
  # roteador) sem resolver a causa. Limpa a máscara que ficou em quem o desligou à mão.
  if [ -L /etc/systemd/system/simba-wifi-vigia.service ]; then
    rm -f /etc/systemd/system/simba-wifi-vigia.service
    systemctl daemon-reload >/dev/null 2>&1 || true
  fi
}
