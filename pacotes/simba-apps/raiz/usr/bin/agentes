def _modelos(a, atualizar=False):
    return _M.modelos(a, atualizar) if _M and hasattr(_M, "modelos") else []


def _modelos_estaticos(a):
    return _M.modelos_estaticos(a) if _M and hasattr(_M, "modelos_estaticos") else []


def _modelo(a, cfg):
    return _M.modelo_escolhido(a, cfg) if _M and hasattr(_M, "modelo_escolhido") else ""


def _aplicar_modelo(a, cmd, modelo):
    if _M and hasattr(_M, "aplicar_modelo"):
        return _M.aplicar_modelo(a, cmd, modelo, interativo=True)
    return cmd

