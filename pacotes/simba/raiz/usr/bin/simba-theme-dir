#!/bin/bash

# simba:summary=Print the directory holding a theme, preferring a user-installed copy
# simba:args=<theme-name>
# simba:examples=simba theme dir tokyo-night

theme="${1:-}"

if [[ -z $theme ]]; then
  echo "Usage: simba-theme-dir <theme-name>" >&2
  exit 1
fi

if [[ -d $HOME/.config/simba/themes/$theme ]]; then
  echo "$HOME/.config/simba/themes/$theme"
else
  echo "$SIMBA_PATH/themes/$theme"
fi
