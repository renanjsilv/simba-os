#!/bin/bash
# Draco (internally still "draco"): voice assistant.
#   draco start  -> begin recording the microphone (bound to F10 press)
#   draco stop   -> stop, transcribe (Parakeet here and/or Whisper on Groq), ask Claude Code, speak the answer (Piper)
#   draco cancel -> abort whatever Draco is doing (bound to Esc)
#   draco reset  -> forget the current conversation
#   draco say "texto" -> just speak a text
#   draco perguntar "texto" -> a typed request (Start menu): same as voice, minus the mic
#   draco config -> settings window: AI provider, transcription, voice, timings (Super+F10)

DATA="$HOME/.local/share/draco"          # dados: venv, vozes, Whisper, logs, workdir
CODIGO="${DRACO_CODIGO:-/usr/share/draco}" # código (pacote simba-draco)
RUN="${XDG_RUNTIME_DIR:-/tmp}/draco"
CLAUDE="$HOME/.local/share/mise/installs/claude/latest/claude"
TTS="$CODIGO/tts.py" # keeps the Piper voice loaded; see the file for details
CONFIG="$CODIGO/lib/config.py" # settings (~/.config/draco): AI provider, transcription, voice, timings
LOG="$DATA/draco.log"

mkdir -p "$RUN" "$DATA/workdir"

notify() { notify-send -a Draco -t "${2:-4000}" "Draco" "$1"; }

# DRACO_PRONTO, DRACO_STT_URL/KEY/MODELO, DRACO_CLAUDE_ENV, DRACO_MEMORIA (see config.py env)
load_config() { eval "$(python3 "$CONFIG" env)"; }

# Settings window (~/.config/quickshell/draco-config); $1: why it opened, shown on top.
settings() {
  if qs -c draco-config ipc call config show "${1:-}" >/dev/null 2>&1; then return; fi
  DRACO_CONFIG_MOTIVO="${1:-}" setsid -f qs -c draco-config -n >/dev/null 2>&1
}

# Nothing to answer with yet (fresh install): open the settings instead.
need_config() {
  [[ -n $DRACO_PRONTO ]] && return 1
  log "sem IA configurada: abrindo as configurações"
  ui hide
  settings "$(simba-t "Escolha qual IA o Draco vai usar para começar.")"
  return 0
}
log() { echo "$(date '+%F %T') $*" >>"$LOG"; }

# Primeiro nome de quem usa o computador (campo de nome da conta; senão o login com maiúscula)
nome_usuario() {
  local n
  n=$(getent passwd "$USER" | cut -d: -f5 | cut -d, -f1 | awk '{print $1}')
  [[ -n $n ]] || n=${USER^}
  printf '%s' "$n"
}

# Instruções da IA no idioma da sessão: prompt.<lingua>.md (ex.: prompt.en.md); português = prompt.md
prompt_file() {
  local f="$CODIGO/prompt.${DRACO_LINGUA:-pt}.md"
  [[ ${DRACO_LINGUA:-pt} != pt && -f $f ]] && echo "$f" || echo "$CODIGO/prompt.md"
}

# On-screen orb (/etc/xdg/quickshell/draco/Draco.qml, hosted by the Configurações shell). Commands go through
# $RUN/orb.cmd, which the orb watches: milliseconds, where `qs ipc call` costs ~260 ms.
orb_running() { # pid cached in $RUN/orb.pid: pgrep alone costs ~120 ms
  local pid
  pid=$(cat "$RUN/orb.pid" 2>/dev/null)
  # qs or quickshell: the orb usually lives inside the Configurações shell (qs -c configuracoes)
  [[ -n $pid && $(cat "/proc/$pid/comm" 2>/dev/null) == @(qs|quickshell) ]] && return 0
  pid=$(pgrep -f '^(/usr/bin/)?qs -c draco -n' | head -n1)
  [[ -n $pid ]] && echo "$pid" >"$RUN/orb.pid"
}
ensure_ui() {
  orb_running && return
  rm -f "$RUN/orb.cmd"
  qs -c draco -n -d >/dev/null 2>&1
  for _ in {1..60}; do
    qs -c draco ipc show >/dev/null 2>&1 && return
    sleep 0.05
  done
}
ui() {
  [[ -n $DRACO_SECO ]] && return 0 # tests: never touch the on-screen orb
  touch "$RUN/shown"
  [[ $(stat -c %s "$RUN/orb.cmd" 2>/dev/null || echo 0) -gt 100000 ]] && : >"$RUN/orb.cmd"
  jq -cn --arg s "$(date +%s%N)" --arg c "$1" '{s: $s, c: $c, a: $ARGS.positional}' --args -- "${@:2}" >>"$RUN/orb.cmd"
  orb_running
}

# Show an error on the orb, falling back to a notification.
fail() { ui fail "$1" || notify "$1"; }

# Kill a process and all its descendants; the parent goes first so it can't
# react to its children dying (e.g. by speaking an error). $2: signal (TERM).
killtree() {
  local pids=("$1") i=0 c
  while ((i < ${#pids[@]})); do
    for c in $(pgrep -P "${pids[i]}"); do pids+=("$c"); done
    ((i++))
  done
  kill -"${2:-TERM}" "${pids[@]}" 2>/dev/null
}

killpidfile() {
  [[ -f $RUN/$1.pid ]] && killtree "$(cat "$RUN/$1.pid")" "$2"
  rm -f "$RUN/$1.pid"
}

stop_speaking() { killpidfile speak; }

# The instructions: prompt.md with the user's name; in "só assistente de voz" mode
# (PERMISSAO=voz) a note that files and the terminal are off. The note only explains:
# the tool permissions (config.py: claude_voice_only_args / opencode_permission) enforce it.
prompt_text() {
  sed "s/{USUARIO}/$(nome_usuario)/g" "$(prompt_file)"
  [[ $DRACO_PERMISSAO == voz ]] || return 0
  printf '\n\n## %s\n%s\n' "$(simba-t "Modo só assistente de voz")" \
    "$(simba-t "Nas configurações, a pessoa escolheu que você seja só um assistente de voz: você NÃO pode mexer em arquivos nem no sistema (nada de ler ou editar arquivos, terminal, teclas, WhatsApp). Pode responder, pesquisar na web, tocar e controlar mídia, criar lembretes, abrir apps e sites, mudar volume e brilho e ler a tela. Se pedirem algo fora disso, diga em uma frase que nesse modo você não mexe no computador e que dá para liberar em Super + F10, Permissões.")"
}

# Claude Code, as Draco runs it. Speed: low effort, no MCP connectors, only the tools
# Draco uses (smaller prompt, ~40% fewer input tokens); the model and provider come
# from the settings (DRACO_CLAUDE_ENV: Sonnet by default, measured ~2 s faster than
# Opus per request). Helper commands (dr-*) live in $DATA/bin. Extra args go last.
brain() {
  local cenv=()
  cd "$DATA/workdir" || return
  # Free brain (config "gratis"): OpenCode's free models, no account; lib/opencode_brain.py
  # speaks the same stream-json as Claude Code, so the rest of Draco doesn't change.
  if [[ $DRACO_MOTOR == opencode ]]; then
    prompt_text >"$RUN/prompt-opencode.md"
    exec env DRACO_PROMPT_FILE="$RUN/prompt-opencode.md" DRACO_MODELO="$DRACO_MODELO" \
      PATH="$CODIGO/bin:$PATH" python3 "$CODIGO/lib/opencode_brain.py" "$@"
  fi
  eval "cenv=($DRACO_CLAUDE_ENV)"
  # Permissions: everything (default), or only a voice assistant (config.py claude_voice_only_args:
  # web tools and the allowed dr-* commands; -p can't ask, so anything else is refused).
  local perms=(--dangerously-skip-permissions --tools Bash,Read,Edit,Skill,WebSearch,WebFetch)
  [[ $DRACO_PERMISSAO == voz && -n $DRACO_CLAUDE_PERMS ]] && eval "perms=($DRACO_CLAUDE_PERMS)"
  exec env "${cenv[@]}" PATH="$CODIGO/bin:$PATH" "$CLAUDE" -p \
    "${perms[@]}" \
    --effort low --strict-mcp-config --exclude-dynamic-system-prompt-sections \
    --output-format stream-json --verbose \
    --append-system-prompt "$(prompt_text)" "$@"
}

continue_flag() { # --continue within the conversation memory window
  local last
  last=$(cat "$RUN/last" 2>/dev/null || echo 0)
  (($(date +%s) - last < ${DRACO_MEMORIA:-600})) && echo --continue
}

# Start Claude Code while you are still talking: its ~2 s startup is then done by the
# time the transcript is ready. It waits for the request on a FIFO (stream-json input);
# brain-hold keeps the FIFO open until process() writes the request (or 90 s pass).
brain_warm() {
  brain_kill
  [[ $DRACO_MOTOR == opencode ]] && return # OpenCode takes the request on the command line
  rm -f "$RUN/brain.in" "$RUN/brain.out"
  mkfifo "$RUN/brain.in" || return
  # shellcheck disable=SC2046
  (brain $(continue_flag) --input-format stream-json <"$RUN/brain.in" >"$RUN/brain.out" 2>>"$LOG") &
  echo $! >"$RUN/brain.pid"
  (exec 3>"$RUN/brain.in"; sleep 90) &
  echo $! >"$RUN/brain-hold.pid"
}

brain_kill() {
  killpidfile brain-hold
  killpidfile brain KILL
  rm -f "$RUN/brain.in"
}

# Claude's event stream for request $1: from the warm one if it's there, else a new one.
ask() {
  local pid
  pid=$(cat "$RUN/brain.pid" 2>/dev/null)
  if [[ -n $pid && -p $RUN/brain.in ]] && kill -0 "$pid" 2>/dev/null &&
    kill -0 "$(cat "$RUN/brain-hold.pid" 2>/dev/null)" 2>/dev/null; then
    jq -cn --arg t "$1" '{type: "user", message: {role: "user", content: $t}}' >"$RUN/brain.in"
    killpidfile brain-hold # EOF after the request: Claude ends when it's answered
    rm -f "$RUN/brain.in"
    log "IA: já estava pronta"
    tail -n +1 -f --pid="$pid" "$RUN/brain.out"
  else
    # shellcheck disable=SC2046
    (brain $(continue_flag) -- "$1" </dev/null 2>>"$LOG")
  fi
}

speak() {
  stop_speaking
  (
    ensure_ui
    : >"$RUN/speech.level"
    ui speak "$1" "$RUN/speech.level" || notify "$1" 10000
    python3 "$TTS" say --levels "$RUN/speech.level" "$1"
    ui done
  ) &
  echo $! >"$RUN/speak.pid"
  wait
  rm -f "$RUN/speak.pid"
}

start() {
  [[ -f $RUN/rec.pid ]] && kill -0 "$(cat "$RUN/rec.pid")" 2>/dev/null && return
  load_config
  need_config && return
  killpidfile job KILL # a new request replaces the one still running
  stop_speaking
  # rm first: the local STT server follows this file as it grows (it must not catch the old one)
  rm -f "$RUN/input.wav"
  pw-record --rate 16000 --channels 1 --format s16 "$RUN/input.wav" &
  echo $! >"$RUN/rec.pid"
  log "start (pid $!)"
  stt_local_start
  brain_warm
  ensure_ui
  ui listening || notify "🎙️ Ouvindo..." 60000
}

# Local speech server (lib/stt_server.py, draco-stt.service): follow the recording as it
# grows, so most of it is already transcribed when F10 is released. Never blocks F10.
stt_local_start() {
  if [[ -S $RUN/stt.sock ]]; then
    (python3 -I "$CODIGO/lib/stt_server.py" start "$RUN/input.wav" >/dev/null 2>&1 &)
  else # not running (yet): next time it will be
    (systemctl --user start --no-block draco-stt.service >/dev/null 2>&1 &)
  fi
}
stt_local_cancel() {
  [[ -S $RUN/stt.sock ]] && (python3 -I "$CODIGO/lib/stt_server.py" cancelar >/dev/null 2>&1 &)
  return 0
}

process() {
  local text reply duration rc

  local t0=${EPOCHREALTIME/[.,]/} size cloud_pid="" local_text="" local_ok=0 waited
  # length from the file size (s16 mono 16 kHz; ffprobe cost ~60 ms right after F10)
  size=$(stat -c %s "$RUN/input.wav" 2>/dev/null || echo 0)
  duration=$(awk "BEGIN{printf \"%.2f\", ($size - 44) / 32000}")
  log "gravação: ${duration}s"

  if awk "BEGIN{exit !(${duration:-0} < 0.6)}"; then
    stt_local_cancel
    fail "$(simba-t "Segure F10 enquanto fala")"
    return
  fi

  ui transcribe

  # Two recognizers, at the same time:
  # - in the cloud (Groq/OpenAI, if chosen): Whisper large; F10 audio comes straight from
  #   pw-record, so first cut the low rumble (fan/table, < 80 Hz) that was burying the voice.
  #   No prompt: Whisper repeats it when the audio is bad. verbose_json: per-segment scores
  #   to drop what Whisper made up over silence (lib/transcript.py).
  # - on this computer (lib/stt_server.py, Parakeet, draco-stt.service): it has been
  #   decoding while F10 was held, so only the last ~2 s are left (~0.3 s).
  # Hybrid: the cloud text wins if it arrives within DRACO_STT_ESPERA s (no network, slow
  # network, key refused... -> the local text, with no extra wait).
  rc=1
  if [[ -n $DRACO_STT_URL ]]; then
    stt() { # <wav> <out.json>
      curl -sS --max-time 15 "$DRACO_STT_URL/audio/transcriptions" \
        -H "Authorization: Bearer $DRACO_STT_KEY" \
        -F model="$DRACO_STT_MODELO" -F language="${DRACO_LINGUA:-pt}" -F temperature=0 -F response_format=verbose_json \
        -F 'timestamp_granularities[]=word' -F 'timestamp_granularities[]=segment' \
        -F file=@"$1" -o "$2" 2>>"$LOG"
    }
    rm -f "$RUN/transcript.json"
    (
      f="$RUN/input.wav"
      ffmpeg -v error -y -i "$f" -af highpass=f=80,highpass=f=80 "$RUN/input-hp.wav" && f="$RUN/input-hp.wav"
      stt "$f" "$RUN/transcript.json"
    ) &
    cloud_pid=$!
  fi
  if local_text=$(python3 -I "$CODIGO/lib/stt_server.py" fim 8 2>>"$LOG"); then
    local_ok=1
    log "transcrição local pronta em $(((${EPOCHREALTIME/[.,]/} - t0) / 1000)) ms"
  fi
  if [[ -n $cloud_pid ]]; then
    # with the local text in hand, wait for the cloud only DRACO_STT_ESPERA s (from F10)
    local limit=$((local_ok ? $(awk "BEGIN{print int(${DRACO_STT_ESPERA:-2} * 1000000)}") : 16000000))
    while kill -0 "$cloud_pid" 2>/dev/null && ((${EPOCHREALTIME/[.,]/} - t0 < limit)); do
      sleep 0.03
    done
    waited=$(((${EPOCHREALTIME/[.,]/} - t0) / 1000))
    if kill -0 "$cloud_pid" 2>/dev/null; then
      killtree "$cloud_pid"
      log "transcrição na nuvem demorou mais de ${waited} ms: usando a local"
    elif jq -e '.segments' "$RUN/transcript.json" >/dev/null 2>&1; then
      text=$(python3 "$CODIGO/lib/transcript.py" groq "$RUN/transcript.json")
      rc=$?
      log "transcrição: nuvem (${waited} ms)"
    else
      log "transcrição na nuvem falhou"
    fi
  fi
  if ((rc == 1)); then
    if ((local_ok)); then
      text=$local_text
      log "transcrição: local (servidor)"
    elif [[ -x $DATA/venv/bin/python ]]; then
      # no server (not prepared yet, or it crashed): load a model just for this request
      text=$("$DATA/venv/bin/python" "$CODIGO/lib/stt_local.py" "$RUN/input.wav" "${DRACO_STT_LOCAL:-parakeet}" 2>>"$LOG" | tail -n1)
      log "transcrição: local sem servidor (${DRACO_STT_LOCAL:-parakeet})"
    else
      text=$(voxtype -q --model small --language "${DRACO_LINGUA:-pt}" transcribe "$RUN/input.wav" 2>/dev/null | tail -n1)
      log "transcrição: voxtype"
    fi
    text=$(python3 "$CODIGO/lib/transcript.py" text "$text")
    rc=$?
  fi
  log "texto pronto em $(((${EPOCHREALTIME/[.,]/} - t0) / 1000)) ms"

  log "pedido recebido"
  responder "$text"
}

# Pergunta já em texto (transcrita ou digitada): pensa, age, fala a resposta.
responder() {
  local text=$1 reply
  [[ -n $DRACO_SECO ]] && { echo "$text"; return; } # tests: stop before Claude

  if [[ -z $text || ${#text} -lt 2 ]]; then
    fail "$(simba-t "Não entendi nada")"
    return
  fi
  ui think "$text"

  # Stream Claude's events: show each action on screen, and shrink the orb
  # into the voice line once the first action starts.
  # The request carries the date and time, so "que dia é hoje" needs no extra step.
  local line type desc acted=0 failed=0 now_txt
  if [[ ${DRACO_LINGUA:-pt} == pt ]]; then now_txt=$(LC_TIME=pt_BR.UTF-8 date '+%A, %d/%m/%Y, %H:%M')
  else now_txt=$(LC_TIME=en_US.UTF-8 date '+%A, %m/%d/%Y, %H:%M'); fi
  while IFS= read -r line; do
    type=$(jq -r '.type // empty' <<<"$line" 2>/dev/null)
    case $type in
      assistant)
        desc=$(jq -r '.message.content[]? | select(.type == "tool_use") | .input.description // .name' <<<"$line" | tail -n1)
        if [[ -n $desc ]]; then
          ui action "$desc"
          # Shrink the orb as soon as Draco starts acting, so the screen (and
          # the OCR in the dr-* helpers) can see what it is doing.
          ((acted)) || { acted=1; ui acted; }
        fi
        ;;
      result)
        reply=$(jq -r '.result // empty' <<<"$line")
        [[ $(jq -r '.is_error' <<<"$line") == true ]] && failed=1
        break
        ;;
    esac
  done < <(ask "[$(simba-t "agora"): $now_txt] $text")
  date +%s >"$RUN/last"
  log "resposta pronta"

  # Not signed in / key refused / out of credit: say so, and open the settings.
  if ((failed)) && grep -qiE "api key|login|auth|credit|billing|balance|quota|401|403|402" <<<"$reply"; then
    log "erro da IA (conta/chave)"
    reply="$(simba-t "Não consegui falar com a IA: a conta ou a chave não está funcionando. Abri as configurações.")"
    settings "$(simba-t "A IA recusou o pedido: confira a conta ou a chave.")"
  fi
  [[ -z $reply ]] && reply="$(simba-t "Desculpe, não consegui responder.")"
  speak "$reply"
}

# Pedido digitado (menu Iniciar › "Pergunte ao Draco"): mesmo caminho da voz,
# sem gravar nem transcrever.
perguntar() {
  local text="$*"
  [[ -n ${text// /} ]] || return 0
  load_config
  need_config && return
  killpidfile job KILL
  stop_speaking
  echo $$ >"$RUN/job.pid"
  ensure_ui
  log "pedido digitado"
  brain_warm
  responder "$text"
  [[ $(cat "$RUN/job.pid" 2>/dev/null) == "$$" ]] && { rm -f "$RUN/job.pid"; brain_kill; }
}

stop() {
  [[ -f $RUN/rec.pid ]] || { log "stop sem gravação ativa"; ui hide; return; }
  load_config
  local pid
  pid=$(cat "$RUN/rec.pid")
  rm -f "$RUN/rec.pid"
  sleep 0.3 # keep the tail of the last word
  kill -INT "$pid" 2>/dev/null
  while kill -0 "$pid" 2>/dev/null; do sleep 0.05; done
  echo $$ >"$RUN/job.pid"
  process
  [[ $(cat "$RUN/job.pid" 2>/dev/null) == "$$" ]] && { rm -f "$RUN/job.pid"; brain_kill; }
}

cancel() {
  # Esc is bound globally (without swallowing the key), so do nothing unless
  # Draco is actually busy or on screen.
  [[ -f $RUN/rec.pid || -f $RUN/job.pid || -f $RUN/speak.pid ||
    -n $(find "$RUN/shown" -newermt '-20 seconds' 2>/dev/null) ]] || return 0
  # Draco's own keystrokes (dr-key) go through the compositor and hit this bind too.
  [[ -n $(find "$RUN/synthetic-keys" -newermt '-1.5 seconds' 2>/dev/null) ]] && return 0
  if [[ -f $RUN/rec.pid ]]; then
    kill "$(cat "$RUN/rec.pid")" 2>/dev/null
    rm -f "$RUN/rec.pid"
    stt_local_cancel
  fi
  killpidfile job KILL # Claude must not get to run one more action
  brain_kill
  stop_speaking
  ui hide
  rm -f "$RUN/shown"
  log "cancelado"
}

case "$1" in
  start) start ;;
  stop) stop ;;
  cancel) cancel ;;
  reset) rm -f "$RUN/last" && notify "$(simba-t "Conversa reiniciada.")" ;;
  say) speak "${*:2}" ;;
  perguntar) perguntar "${@:2}" ;;
  config) settings "${*:2}" ;;
  # primeira vez (ou depois de atualizar o Python): ambiente Python e vozes do idioma da sessão
  preparar) exec "$CODIGO/bin/draco-preparar" "${@:2}" ;;
  # reconhecimento de fala neste computador, residente (draco-stt.service)
  servidor-stt)
    [[ -x $DATA/venv/bin/python ]] || "$CODIGO/bin/draco-preparar" --quieto || exit 1
    exec "$DATA/venv/bin/python" "$CODIGO/lib/stt_server.py" serve ;;
  servidor-voz)
    [[ -x $DATA/venv/bin/python ]] || "$CODIGO/bin/draco-preparar" --quieto || exit 1
    # já preparado numa versão anterior: completa o que esta versão traz (modelo de fala
    # local, IA grátis) em segundo plano, sem atrasar a voz
    pk_rev=$(grep -o '^PK_REV=[0-9a-f]*' "$CODIGO/bin/draco-preparar" | cut -d= -f2)
    if [[ $(cat "$DATA/models/parakeet/REVISAO" 2>/dev/null) != "$pk_rev" ]] ||
       ! systemctl --user is-enabled --quiet draco-stt.service; then
      setsid -f "$CODIGO/bin/draco-preparar" --quieto >>"$LOG" 2>&1
    fi
    exec "$DATA/venv/bin/python" "$TTS" serve ;;
  *) echo "uso: draco start|stop|cancel|reset|say <texto>|perguntar <texto>|config|preparar|servidor-stt|servidor-voz" >&2; exit 1 ;;
esac
