#!/bin/bash

# simba:summary=Launch or focus on a given web app identified by the window-pattern.
# simba:args=<window-pattern> <url-and-flags...>

if (($# == 0)); then
  echo "Usage: simba-launch-or-focus-webapp [window-pattern] [url-and-flags...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift
LAUNCH_COMMAND="simba-launch-webapp $@"

exec simba-launch-or-focus "$WINDOW_PATTERN" "$LAUNCH_COMMAND"
