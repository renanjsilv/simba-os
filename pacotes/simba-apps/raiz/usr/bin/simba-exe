#!/usr/bin/env python3
"""simba-exe — Integrador nativo e inteligente de executáveis Windows (.exe, .msi, .bat).

Analisa o executável e seleciona o melhor interpretador do mercado:
- Jogos e motores 3D (DirectX, Vulkan, Unreal, Unity, etc.): executa com Proton / UMU (umu-run)
  com DXVK, VKD3D, protonfixes e aceleração máxima.
- Softwares e utilitários gerais: executa com Wine Staging com baixo consumo de memória
  e inicialização instantânea.
"""

import os
import sys
import shutil
import subprocess
import argparse
from pathlib import Path

# Palavras-chave e assinaturas para detecção inteligente
GAME_KEYWORDS = {
    "game", "jogo", "jogos", "play", "rpg", "chaos", "repack",
    "trainer", "unreal", "unity", "godot", "cryengine", "steam"
}

GAME_DIRS = {
    "games", "jogos", "steamapps", "lutris", "heroic", "bottles", "roms"
}

# Assinaturas binárias (procuradas em ASCII e UTF-16LE)
GRAPHICS_SIGS = [
    b"d3d9.dll", b"d3d11.dll", b"d3d12.dll", b"dxgi.dll", b"vulkan-1.dll",
    b"xinput1_3.dll", b"xinput1_4.dll", b"xinput9_1_0.dll", b"dinput8.dll",
    b"x3daudio", b"nvapi64.dll", b"amd_ags_x64.dll"
]

ENGINE_SIGS = [
    b"unityplayer.dll", b"unitycrashhandler", b"unrealengine", b"epicgames",
    b"godot", b"cryengine", b"physx", b"fmod", b"wwise", b"criware",
    b"binkvideo", b"steam_api.dll", b"steam_api64.dll", b"galaxy.dll",
    b"eos_sdk", b"miles64.dll"
]

INSTALLER_SIGS = [
    b"inno setup", b"nullsoft install", b"installshield", b"wise installation"
]


def notify(title: str, message: str, icon: str = "wine"):
    """Envia notificação nativa da área de trabalho."""
    try:
        subprocess.Popen(
            ["notify-send", "-a", "Simba OS", "-i", icon, title, message],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )
    except Exception:
        pass


def get_hybrid_gpu_env() -> dict:
    """Detecta GPUs dedicadas (NVIDIA / AMD) em notebooks híbridos para máxima performance em jogos."""
    env_additions = {}
    pci_path = Path("/sys/bus/pci/devices")
    if not pci_path.exists():
        return env_additions

    has_nvidia = False
    has_amd_dgpu = False
    has_igpu = False

    try:
        for dev in pci_path.iterdir():
            class_file = dev / "class"
            vendor_file = dev / "vendor"
            if not class_file.exists() or not vendor_file.exists():
                continue
            pci_class = class_file.read_text().strip()
            if pci_class.startswith("0x03"):  # VGA ou 3D controller
                vendor = vendor_file.read_text().strip().lower()
                if vendor == "0x10de":
                    has_nvidia = True
                elif vendor == "0x1002":
                    has_amd_dgpu = True
                elif vendor == "0x8086":
                    has_igpu = True
    except Exception:
        pass

    # Em sistemas híbridos com NVIDIA dedicada
    if has_nvidia and (has_igpu or shutil.which("prime-run")):
        env_additions["__NV_PRIME_RENDER_OFFLOAD"] = "1"
        env_additions["__GLX_VENDOR_LIBRARY_NAME"] = "nvidia"
        env_additions["__VK_LAYER_NV_optimus"] = "NVIDIA_only"
    elif has_amd_dgpu and has_igpu:
        env_additions["DRI_PRIME"] = "1"

    return env_additions


def get_display_scale() -> float:
    """Detecta a escala do monitor ativo no Hyprland para renderização correta em HiDPI."""
    try:
        raw = subprocess.check_output(["hyprctl", "monitors", "-j"], text=True, stderr=subprocess.DEVNULL)
        import json
        monitors = json.loads(raw)
        for m in monitors:
            if m.get("focused") or m.get("scale", 1) > 1:
                return float(m.get("scale", 1.0))
        if monitors:
            return float(monitors[0].get("scale", 1.0))
    except Exception:
        pass
    return 1.0


def ensure_interpreters(has_wine: bool, has_umu: bool) -> tuple[bool, bool]:
    """Oferece instalação sob demanda caso nenhum interpretador esteja instalado."""
    if has_wine or has_umu:
        return has_wine, has_umu

    zenity = shutil.which("zenity")
    has_display = bool(os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY"))

    if zenity and has_display:
        try:
            ret = subprocess.call([
                zenity, "--question", "--title=Simba OS — Compatibilidade Windows",
                "--width=440",
                "--text=Para abrir executáveis Windows (.exe, .msi), o Simba OS precisa instalar o Wine e o Proton.\n\nDeseja instalar os componentes agora?",
                "--ok-label=Instalar", "--cancel-label=Cancelar"
            ])
            if ret == 0:
                install_cmd = (
                    "pkexec pacman -S --noconfirm wine-staging wine-mono wine-gecko umu-launcher gamemode "
                    "| zenity --progress --pulsate --auto-close --title='Simba OS' "
                    "--text='Instalando suporte a aplicações e jogos Windows...' --width=420"
                )
                subprocess.call(install_cmd, shell=True)
                has_wine = shutil.which("wine") is not None
                has_umu = shutil.which("umu-run") is not None
        except Exception:
            pass

    return has_wine, has_umu


def analyze_target(file_path: Path) -> dict:
    """Analisa o arquivo e define o melhor interpretador."""
    filename = file_path.name.lower()
    parent_dirs = [p.name.lower() for p in file_path.parents]

    # Pontuação de jogo
    score = 0
    reasons = []

    # 1. Pistas no nome do arquivo
    for kw in GAME_KEYWORDS:
        if kw in filename:
            score += 2
            reasons.append(f"nome:{kw}")

    # 2. Pistas no diretório onde o arquivo reside
    for gd in GAME_DIRS:
        if gd in parent_dirs:
            score += 3
            reasons.append(f"pasta:{gd}")

    # 3. Leitura do cabeçalho binário (primeiros 15 MB para rapidez)
    is_installer = any(k in filename for k in ["setup", "install", "instalador"])
    try:
        with open(file_path, "rb") as f:
            chunk = f.read(15 * 1024 * 1024)
            lower_chunk = chunk.lower()

            for sig in ENGINE_SIGS:
                if sig in lower_chunk or sig.decode("latin1", errors="ignore").encode("utf-16le") in lower_chunk:
                    score += 4
                    reasons.append(f"motor:{sig.decode('latin1', errors='ignore')}")

            for sig in GRAPHICS_SIGS:
                if sig in lower_chunk or sig.decode("latin1", errors="ignore").encode("utf-16le") in lower_chunk:
                    score += 3
                    reasons.append(f"graficos:{sig.decode('latin1', errors='ignore')}")

            for sig in INSTALLER_SIGS:
                if sig in lower_chunk or sig.decode("latin1", errors="ignore").encode("utf-16le") in lower_chunk:
                    is_installer = True
                    reasons.append(f"instalador:{sig.decode('latin1', errors='ignore')}")
    except Exception:
        pass

    is_game = score >= 2
    return {
        "is_game": is_game,
        "is_installer": is_installer,
        "score": score,
        "reasons": reasons
    }


def integrate_installed_shortcuts(prefix: Path = None, is_game: bool = True):
    """Escaneia o prefixo e o diretório de aplicações por atalhos (.desktop / .lnk) recém-instalados,
    criando lançadores nativos padronizados no menu de aplicativos do Simba OS."""
    apps_dir = Path.home() / ".local/share/applications"
    apps_dir.mkdir(parents=True, exist_ok=True)

    wine_apps_dir = apps_dir / "wine"
    created_launchers = []

    # 1. Processa .desktop criados pelo Wine sob ~/.local/share/applications/wine/
    if wine_apps_dir.exists():
        for dt_path in wine_apps_dir.glob("**/*.desktop"):
            try:
                content = dt_path.read_text(encoding="utf-8", errors="ignore")
                dt_name = dt_path.name.lower()

                # Oculta desinstaladores, links para websites, readmes e ajuda
                is_junk = any(j in dt_name or j in content.lower() for j in [
                    "desinstalar", "uninstall", "unins000", "readme", "ajuda", "help",
                    "website", "homepage", "documentation", "support", "manual"
                ])
                if is_junk:
                    if "NoDisplay=true" not in content:
                        dt_path.write_text(content.strip() + "\nNoDisplay=true\n", encoding="utf-8")
                    continue

                props = {}
                for line in content.splitlines():
                    if "=" in line and not line.strip().startswith("#"):
                        k, v = line.split("=", 1)
                        props[k.strip()] = v.strip()

                app_title = props.get("Name", dt_path.stem)
                exe_dir = props.get("Path", "")
                icon_name = props.get("Icon", "applications-games" if is_game else "application-x-executable")
                wmclass = props.get("StartupWMClass", "")

                target_exe = None
                if exe_dir and Path(exe_dir).is_dir():
                    dir_path = Path(exe_dir)
                    if wmclass and (dir_path / wmclass).exists():
                        target_exe = dir_path / wmclass
                    else:
                        exes = [
                            f for f in dir_path.glob("*.exe")
                            if not any(u in f.name.lower() for u in ["unins", "setup", "install", "crash"])
                        ]
                        if exes:
                            best = next((e for e in exes if app_title.lower().replace(" ", "") in e.name.lower()), exes[0])
                            target_exe = best

                if target_exe and target_exe.exists():
                    clean_id = "".join(c if c.isalnum() else "_" for c in app_title.lower()).strip("_")
                    if not is_game and (apps_dir / f"simba-game-{clean_id}.desktop").exists():
                        continue
                    new_dt_path = apps_dir / f"simba-{'game' if is_game else 'app'}-{clean_id}.desktop"

                    new_content = [
                        "[Desktop Entry]",
                        f"Name={app_title}",
                        f"Comment={'Jogo Windows integrado pelo Simba OS' if is_game else 'Aplicativo Windows integrado pelo Simba OS'}",
                        f"Exec=simba-exe {'--modo jogo ' if is_game else ''}\"{target_exe}\"",
                        f"Path={target_exe.parent}",
                        f"Icon={icon_name}",
                        "Terminal=false",
                        "Type=Application",
                        f"Categories={'Game;' if is_game else 'Utility;Application;'}",
                    ]
                    if wmclass:
                        new_content.append(f"StartupWMClass={wmclass}")

                    new_dt_path.write_text("\n".join(new_content) + "\n", encoding="utf-8")
                    created_launchers.append(app_title)

                    if "NoDisplay=true" not in content:
                        dt_path.write_text(content.strip() + "\nNoDisplay=true\n", encoding="utf-8")
            except Exception:
                pass

    # 2. Se temos prefixo, varre também por .lnk na Área de Trabalho ou Menu Iniciar virtual
    prefixes_to_check = [prefix] if prefix else [Path.home() / ".local/share/simba-exe/prefixes/jogos",
                                                  Path.home() / ".local/share/simba-exe/prefixes/apps",
                                                  Path.home() / ".wine"]
    for pfx in prefixes_to_check:
        if not pfx or not pfx.exists():
            continue
        drive_c = pfx / "drive_c"
        desktop_dirs = [
            drive_c / "users/Public/Desktop",
            drive_c / "ProgramData/Microsoft/Windows/Start Menu/Programs"
        ]
        users_dir = drive_c / "users"
        if users_dir.is_dir():
            for u in users_dir.iterdir():
                desktop_dirs.append(u / "Desktop")
                desktop_dirs.append(u / "AppData/Roaming/Microsoft/Windows/Start Menu/Programs")

        for d in desktop_dirs:
            if not d.is_dir():
                continue
            for lnk in d.glob("**/*.lnk"):
                lnk_name = lnk.stem
                if any(u in lnk_name.lower() for u in ["unins", "desinstalar", "help", "ajuda"]):
                    continue
                clean_id = "".join(c if c.isalnum() else "_" for c in lnk_name.lower()).strip("_")
                if (apps_dir / f"simba-game-{clean_id}.desktop").exists() or (apps_dir / f"simba-app-{clean_id}.desktop").exists():
                    continue
                new_dt_path = apps_dir / f"simba-{'game' if is_game else 'app'}-{clean_id}.desktop"
                if not new_dt_path.exists():
                    new_content = [
                        "[Desktop Entry]",
                        f"Name={lnk_name}",
                        f"Comment={'Jogo Windows integrado pelo Simba OS' if is_game else 'Aplicativo Windows integrado pelo Simba OS'}",
                        f"Exec=simba-exe {'--modo jogo ' if is_game else ''}\"{lnk}\"",
                        "Terminal=false",
                        "Type=Application",
                        f"Icon={'applications-games' if is_game else 'application-x-executable'}",
                        f"Categories={'Game;' if is_game else 'Utility;Application;'}",
                    ]
                    try:
                        new_dt_path.write_text("\n".join(new_content) + "\n", encoding="utf-8")
                        created_launchers.append(lnk_name)
                    except Exception:
                        pass

    if created_launchers:
        try:
            subprocess.run(["update-desktop-database", str(apps_dir)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

        distinct = list(dict.fromkeys(created_launchers))
        nomes = ", ".join(distinct[:3])
        notify(
            "Instalação Concluída!",
            f"Atalho para '{nomes}' adicionado ao seu menu de aplicativos.",
            "applications-games" if is_game else "wine"
        )


def main():
    parser = argparse.ArgumentParser(
        description="Simba OS — Integrador inteligente de aplicações Windows (.exe)"
    )
    parser.add_argument("arquivo", nargs="?", default="", help="Caminho para o executável (.exe, .msi, .bat)")
    parser.add_argument("args", nargs=argparse.REMAINDER, help="Argumentos repassados ao programa")
    parser.add_argument("--modo", choices=["auto", "jogo", "app", "wine", "proton", "umu"],
                        default="auto", help="Forçar modo de execução")
    parser.add_argument("--prefixo", help="Caminho personalizado do WINEPREFIX")
    parser.add_argument("--hud", action="store_true", help="Ativar overlay de métricas (FPS, GPU, CPU) MangoHud")
    parser.add_argument("--integrar", action="store_true", help="Escanear e integrar atalhos de jogos/apps já instalados")

    parsed = parser.parse_args()

    # Diretório base dos prefixos do Simba
    base_data = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "simba-exe"
    prefixes_dir = base_data / "prefixes"
    prefixes_dir.mkdir(parents=True, exist_ok=True)

    if parsed.integrar or (not parsed.arquivo and len(sys.argv) == 1):
        # Modo integração autônoma
        integrate_installed_shortcuts(prefixes_dir / "jogos", is_game=True)
        integrate_installed_shortcuts(prefixes_dir / "apps", is_game=False)
        integrate_installed_shortcuts(Path.home() / ".wine", is_game=True)
        print("Atalhos do Windows sincronizados com o menu de aplicativos.")
        return

    if not parsed.arquivo:
        parser.print_help()
        sys.exit(1)

    target = Path(parsed.arquivo).resolve()
    if not target.exists():
        notify("Erro ao abrir", f"Arquivo não encontrado: {target}", "dialog-error")
        sys.exit(1)

    analysis = analyze_target(target)

    # Determina o interpretador
    env_runner = os.environ.get("SIMBA_RUNNER", "").lower()
    has_umu = shutil.which("umu-run") is not None
    has_wine = shutil.which("wine") is not None

    if not has_wine and not has_umu:
        has_wine, has_umu = ensure_interpreters(has_wine, has_umu)

    if not has_wine and not has_umu:
        notify("Simba OS", "Nenhum interpretador Windows (Wine ou UMU) encontrado.", "dialog-error")
        sys.exit(1)

    # Decisão do modo
    if parsed.modo in ["jogo", "proton", "umu"] or env_runner in ["jogo", "proton", "umu"]:
        use_game = True
    elif parsed.modo in ["app", "wine"] or env_runner in ["app", "wine"]:
        use_game = False
    else:
        use_game = analysis["is_game"]

    # Se selecionado jogo mas não tem umu-run, faz fallback para wine
    if use_game and not has_umu:
        use_game = False

    app_name = target.stem.replace("_", " ").title()

    # Prepara ambiente
    env = os.environ.copy()

    # Muda diretório para o diretório do executável (compatibilidade Windows)
    os.chdir(target.parent)

    extra_args = parsed.args or []

    if use_game:
        # Modo Jogo: UMU + Proton com DXVK/VKD3D e fsync
        game_prefix = Path(parsed.prefixo) if parsed.prefixo else (prefixes_dir / "jogos")
        game_prefix.mkdir(parents=True, exist_ok=True)

        env["WINEPREFIX"] = str(game_prefix)
        env["GAMEID"] = f"simba-{target.stem.lower()[:32]}"
        env["UMU_RUNTIME_UPDATE"] = "0"  # não trava no primeiro boot baixando o runtime inteiro

        # Otimização de GPU híbrida (NVIDIA / AMD)
        gpu_env = get_hybrid_gpu_env()
        if gpu_env:
            env.update(gpu_env)

        # Habilita AMD FidelityFX Super Resolution (FSR) para upscaling inteligente
        env["WINE_FULLSCREEN_FSR"] = env.get("WINE_FULLSCREEN_FSR", "1")
        env["WINE_FULLSCREEN_FSR_STRENGTH"] = env.get("WINE_FULLSCREEN_FSR_STRENGTH", "2")

        cmd = ["umu-run", str(target)] + extra_args

        # Opcional: MangoHud (overlay de FPS e métricas)
        use_hud = parsed.hud or os.environ.get("MANGOHUD") == "1" or os.environ.get("SIMBA_HUD") == "1"
        if use_hud:
            env["MANGOHUD"] = "1"
            mangohud_bin = shutil.which("mangohud")
            if mangohud_bin:
                cmd = [mangohud_bin] + cmd

        # Opcional: GameMode se disponível
        gamemoderun = shutil.which("gamemoderun")
        if gamemoderun:
            cmd = [gamemoderun] + cmd

        try:
            p = subprocess.Popen(cmd, env=env)
            ret = p.wait()
            if ret == 0 and analysis["is_installer"]:
                integrate_installed_shortcuts(game_prefix, is_game=True)
            sys.exit(ret)
        except Exception as e:
            # Fallback transparente para Wine caso UMU falhe
            notify("Aviso", "Proton indisponível, iniciando com Wine...", "dialog-warning")
            cmd = ["wine", str(target)] + extra_args
            if use_hud and shutil.which("mangohud"):
                cmd = [shutil.which("mangohud")] + cmd
            if gamemoderun:
                cmd = [gamemoderun] + cmd
            p = subprocess.Popen(cmd, env=env)
            ret = p.wait()
            if ret == 0 and analysis["is_installer"]:
                integrate_installed_shortcuts(game_prefix, is_game=True)
            sys.exit(ret)

    else:
        # Modo Aplicativo: Wine Staging leve e rápido
        app_prefix = Path(parsed.prefixo) if parsed.prefixo else (prefixes_dir / "apps")
        app_prefix.mkdir(parents=True, exist_ok=True)

        env["WINEPREFIX"] = str(app_prefix)
        env["WINEDEBUG"] = env.get("WINEDEBUG", "-all")  # suprime logs excessivos para velocidade

        # Ajuste inteligente de HiDPI para aplicações clássicas do Windows em telas 2K/4K
        scale = get_display_scale()
        if scale > 1.05:
            target_dpi = int(round(96 * scale))
            dpi_marker = app_prefix / f".dpi_{target_dpi}"
            if not dpi_marker.exists():
                try:
                    subprocess.run(
                        ["wine", "reg", "add", "HKEY_CURRENT_USER\\Control Panel\\Desktop",
                         "/v", "LogPixels", "/t", "REG_DWORD", "/d", str(target_dpi), "/f"],
                        env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False, timeout=5
                    )
                    dpi_marker.touch()
                except Exception:
                    pass

        notify(
            "Simba OS — Modo Aplicativo",
            f"Iniciando {app_name} com Wine...",
            "wine"
        )

        # Se for arquivo .msi, chama msiexec /i
        if target.suffix.lower() == ".msi":
            cmd = ["wine", "msiexec", "/i", str(target)] + extra_args
        elif target.suffix.lower() in [".bat", ".cmd"]:
            cmd = ["wine", "cmd", "/c", str(target)] + extra_args
        else:
            cmd = ["wine", str(target)] + extra_args

        p = subprocess.Popen(cmd, env=env)
        ret = p.wait()
        if ret == 0 and analysis["is_installer"]:
            integrate_installed_shortcuts(app_prefix, is_game=False)
        sys.exit(ret)


if __name__ == "__main__":
    main()
