#!/usr/bin/env python3
"""agentes — vários agentes de IA em sequência: quando o limite de um acaba, o próximo
continua o trabalho com o contexto (Configurações › Agentes de IA).

    agentes                      abre o primeiro agente disponível da lista (neste terminal)
    agentes --prompt "texto"     idem, já com um pedido
    agentes abrir                abre num terminal novo (atalho / barra)
    agentes estado               JSON para a página de Configurações
    agentes ordem <id>...        define a ordem
    agentes ativar <id> 0|1      liga/desliga um agente na lista
    agentes opcao <chave> <json> trocaAutomatica (bool), esperar (segundos)
    agentes entrar <id>          abre o login do agente num terminal
    agentes instalar <id>        baixa e instala o agente (sem terminal; avisa ao terminar)
    agentes remover <id>         desinstala o agente

Como troca: o agente roda num pseudo-terminal; a saída passa direto para a tela e é
vigiada. Ao aparecer o aviso de limite atingido ("usage limit reached", "quota
exceeded"…), mostra uma contagem (Enter troca já, Esc continua), encerra o agente,
monta um arquivo de passagem (~/.local/state/agentes/passagem-*.md) com o pedido,
a conversa, os comandos e o estado do Git, e abre o próximo agente pedindo que leia
esse arquivo e continue de onde parou.
"""
import fcntl
import glob
import json
import os
import pty
import re
import select
import shutil
import signal
import struct
import subprocess
import sys
import termios
import time
import tty
from datetime import datetime, timezone
from pathlib import Path
import sys as _sys, os as _os  # noqa: E401
_sys.path.insert(0, _os.path.expanduser("/usr/share/simba-apps/idiomas"))
from simba_i18n import t as _t  # noqa: E402  (traduções: /usr/share/simba-apps/idiomas)

HOME = Path.home()
CONFIG = HOME / ".config/agentes/config.json"
ESTADO = HOME / ".local/state/agentes"
USO = HOME / ".local/state/simba/agents/usage"
SIMBA_PADRAO = HOME / ".config/simba/defaults/agent"
SIMBA_CONHECE = {"pi", "omp", "opencode", "claude", "codex", "grok", "agy", "openclaw", "hermes", "copilot",
                   "crush", "cursor-agent", "muse"}

# id → nome, comando (as mesmas opções que o simba-agent usa), como passar o pedido,
# login e arquivo que indica login feito
AGENTES = {
    "claude":   {"nome": "Claude Code", "cmd": ["claude", "--permission-mode", "auto"], "prompt": ["--", "{p}"],
                 "login": ["claude", "auth", "login"], "conta": [".claude/.credentials.json"]},
    "codex":    {"nome": "Codex", "cmd": ["codex", "--approve-for-me"], "prompt": ["--", "{p}"],
                 "login": ["codex", "login"], "conta": [".codex/auth.json"]},
    # Antigravity CLI (Google), substituto do Gemini CLI (desativado em jun/2026); login pela conta Google
    "agy":      {"nome": "Antigravity", "cmd": ["agy", "--dangerously-skip-permissions"],
                 "prompt": ["--prompt-interactive", "{p}"], "login": ["agy"], "conta": [],
                 # o token não fica num arquivo conhecido: `agy models` falha ("Please sign in") sem login
                 "verifica": ["agy", "models"], "env": "GEMINI_API_KEY"},
    "opencode": {"nome": "OpenCode", "cmd": ["opencode", "--auto"], "prompt": ["--prompt", "{p}"],
                 "login": ["opencode", "auth", "login"], "conta": [".local/share/opencode/auth.json"]},
    "copilot":  {"nome": "GitHub Copilot", "cmd": ["copilot", "--allow-all"], "prompt": ["--interactive", "{p}"],
                 "login": ["copilot"], "conta": [".copilot/config.json"]},
    "cursor-agent": {"nome": "Cursor", "cmd": ["cursor-agent", "--yolo", "--trust"], "prompt": ["agent", "--", "{p}"],
                     "login": ["cursor-agent", "login"], "conta": [".cursor/cli-config.json"]},
    "grok":     {"nome": "Grok", "cmd": ["grok", "--permission-mode", "bypassPermissions"], "prompt": ["--", "{p}"],
                 "login": ["grok"], "conta": []},
    "crush":    {"nome": "Crush", "cmd": ["crush", "--yolo"], "prompt": None, "login": ["crush"], "conta": []},
    "pi":       {"nome": "Pi", "cmd": ["pi"], "prompt": ["{p}"], "login": ["pi"], "conta": []},
}

# Como instalar cada um (Configurações › Agentes de IA › Instalar): pelo mise, com o valor
# que vai em [tools] do ~/.config/mise/config.toml, ou pelo instalador oficial (Antigravity).
INSTALAR = {
    "claude": {"mise": '"latest"', "sobre": "Anthropic · conta Claude ou chave de API"},
    "agy": {"script": "https://antigravity.google/cli/install.sh", "bin": HOME / ".local/bin/agy",
            "sobre": "Google · conta Google"},
    "codex": {"mise": '"latest"', "sobre": "OpenAI · conta ChatGPT"},
