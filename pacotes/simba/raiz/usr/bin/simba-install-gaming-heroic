#!/bin/bash

# simba:summary=Install Heroic Games Launcher (Epic, GOG, Amazon Prime Gaming) with graphics drivers.
# simba:requires-sudo=true

set -e

echo "Installing Heroic Games Launcher..."
simba-pkg-add heroic-games-launcher-bin
simba-install-gaming-gpu-lib32

setsid uwsm-app -- gtk-launch heroic >/dev/null 2>&1 &
