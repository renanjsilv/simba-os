#!/bin/bash
# inatividade <protecao_s> <bloqueio_s>: set idle.screensaver / idle.lock in
# ~/.config/simba/shell.json (0 = never) with Simba's own shell.json helper,
# which writes atomically and reloads the running shell.
set -euo pipefail
[[ ${1:-} =~ ^[0-9]+$ && ${2:-} =~ ^[0-9]+$ ]] || { echo "uso: inatividade <segundos> <segundos>" >&2; exit 1; }
source simba-shell-config
commit '.idle = ((.idle // {}) + {screensaver: ($s | tonumber), lock: ($l | tonumber)})' --arg s "$1" --arg l "$2"
