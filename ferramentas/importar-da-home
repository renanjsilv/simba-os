#!/usr/bin/env python3
"""importar-da-home — migração única (2026-11-05): copia os componentes próprios do Simba OS,
que nasceram na pasta pessoal do Renan, para as árvores dos pacotes deste repositório.

    ferramentas/importar-da-home [--ver]

Depois disto o repositório é a fonte: edite aqui, gere os pacotes (ferramentas/construir) e
instale. Fica guardado como registro de onde cada coisa veio.
"""
import os
import shutil
import sys

H = os.path.expanduser("~")
R = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
APPS = f"{R}/pacotes/simba-apps/raiz"
DRACO = f"{R}/pacotes/simba-draco/raiz"
SIMBA = f"{R}/pacotes/simba/raiz"

