MISE_CONFIG = HOME / ".config/mise/config.toml"

# Aviso de limite: uma frase inequívoca, ou um termo de limite e um de "acabou/volta às…"
# na mesma linha curta.
FORTES = re.compile(r"(usage limit reached|you'?ve (hit|reached) your (usage |session |weekly )?limit|"
                    r"limit reached.{0,40}reset|out of (extra )?usage|quota exceeded|resource_exhausted|"
                    r"exhausted your (daily )?quota|insufficient_quota|credit balance is too low|"
                    r"limite de uso (atingido|alcançado)|você atingiu (o|seu) limite)", re.I)
LIMITE = re.compile(r"\b(limit|limits|quota|limite|cota|rate.?limit(ed)?)\b", re.I)
ACABOU = re.compile(r"(\breset|\bresets\b|\bupgrade\b|try again|exceeded|\breached\b|exhausted|esgot|atingid)", re.I)
ANSI = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(\x07|\x1b\\)|\x1b[()][0-9A-B]|\x1b[=>78]|\r")


# ── configuração ────────────────────────────────────────────────────────────
def _achar(a):
    """O comando do agente, mesmo antes de o PATH desta sessão ter os atalhos novos."""
    cmd = AGENTES[a]["cmd"][0]
    return shutil.which(cmd) or shutil.which(cmd, path=f"{HOME}/.local/share/mise/shims:{HOME}/.local/bin")


def ler_config():
    instalados = [a for a in AGENTES if _achar(a)]
    # Sem configuração ainda: todos os instalados na lista, mas só os já logados ligados
    padrao = {"ordem": list(instalados), "inativos": [a for a in instalados if conectado(a) is not True],
              "trocaAutomatica": True, "esperar": 8}
    try:
        c = json.loads(CONFIG.read_text())
    except (OSError, ValueError):
        c = {}
    padrao.update(c)
    # agentes instalados depois entram no fim da lista, desligados até você ligar
    for a in instalados:
        if a not in padrao["ordem"]:
            padrao["ordem"].append(a)
            if conectado(a) is not True and a not in padrao["inativos"]:
                padrao["inativos"].append(a)
    return padrao


def gravar_config(c):
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    CONFIG.write_text(json.dumps(c, ensure_ascii=False, indent=1))
    # o "agente padrão" do Simba (diagnóstico de travamentos etc.) acompanha o 1º da lista
    # (só agentes que o simba-default-agent conhece: o Antigravity, por exemplo, ele não aceita)
    lista = [a for a in c["ordem"] if a not in c["inativos"] and a in SIMBA_CONHECE
             and _achar(a)]
    if lista:
        SIMBA_PADRAO.parent.mkdir(parents=True, exist_ok=True)
        SIMBA_PADRAO.write_text(lista[0] + "\n")


def conectado(a):
    info = AGENTES[a]
    if info.get("env") and os.environ.get(info["env"]):
        return True
    if info.get("verifica") and shutil.which(info["verifica"][0]):
        # consulta a internet: guarda a resposta (10 min se logado, 1 min se não)
        marca = ESTADO / f"login-{a}"
        try:
            quando, ok = marca.read_text().split()
            if time.time() - float(quando) < (600 if ok == "1" else 60):
                return ok == "1"
        except (OSError, ValueError):
            pass
        try:
            ok = subprocess.run(info["verifica"], cwd=HOME, stdin=subprocess.DEVNULL, capture_output=True,
                                timeout=20).returncode == 0
        except (OSError, subprocess.TimeoutExpired):
            return None
        ESTADO.mkdir(parents=True, exist_ok=True)
        marca.write_text(f"{time.time()} {int(ok)}")
        return ok
    if not info["conta"]:
        return None  # não dá para saber
    return any((HOME / f).exists() and (HOME / f).stat().st_size > 2 for f in info["conta"])


def uso(a):
    """{sessao, semana, *Volta} a partir do registro do widget de agentes do Simba."""
    try:
        d = json.loads((USO / f"{a}.json").read_text())
    except (OSError, ValueError):
        return {}
    out = {}
    for l in d.get("limits") or []:
        rot = (l.get("label") or "").lower()
        chave = "sessao" if "session" in rot or "5-hour" in rot else "semana" if "week" in rot else None
        if chave and l.get("percent") is not None:
            out[chave] = l["percent"]
            out[chave + "Volta"] = l.get("resetsAt")
    return out


def _futuro(iso):
    try:
        return datetime.fromisoformat(iso.replace("Z", "+00:00")) > datetime.now(timezone.utc)
    except (AttributeError, ValueError):
        return False


def esgotado_ate(a):
    """Quando o agente volta (ISO) se está sem limite agora; None se está disponível."""
    u = uso(a)
    for k in ("sessao", "semana"):
        if u.get(k, 0) >= 0.99 and _futuro(u.get(k + "Volta")):
            return u[k + "Volta"]
    try:
        marcas = json.loads((ESTADO / "esgotados.json").read_text())
    except (OSError, ValueError):
        marcas = {}
    ate = marcas.get(a)
    if ate and _futuro(ate):
        return ate
    return None


def marcar_esgotado(a):
    u = uso(a)
    ate = next((u.get(k + "Volta") for k in ("sessao", "semana") if u.get(k, 0) >= 0.9 and _futuro(u.get(k + "Volta"))), None)
    if not ate:
        ate = datetime.fromtimestamp(time.time() + 3600, timezone.utc).isoformat()
    ESTADO.mkdir(parents=True, exist_ok=True)
    f = ESTADO / "esgotados.json"
    try:
        marcas = json.loads(f.read_text())
    except (OSError, ValueError):
        marcas = {}
    marcas[a] = ate
    f.write_text(json.dumps(marcas))


def candidatos(c, pular=()):
    return [a for a in c["ordem"] if a in AGENTES and a not in c["inativos"] and a not in pular
            and shutil.which(AGENTES[a]["cmd"][0]) and conectado(a) is not False]


def hora(iso):
    try:
        return datetime.fromisoformat(iso.replace("Z", "+00:00")).astimezone().strftime("%d/%m %H:%M")
    except (AttributeError, ValueError):
        return "?"


# ── contexto (arquivo de passagem) ──────────────────────────────────────────
def _corta(t, n):
    t = str(t)
    return t if len(t) <= n else t[:n] + " […]"


def transcricao_claude(cwd, desde):
    pasta = HOME / ".claude/projects" / re.sub(r"[/.]", "-", str(cwd))
    arqs = [p for p in pasta.glob("*.jsonl") if p.stat().st_mtime >= desde - 5]
    if not arqs:
        return None
    arq = max(arqs, key=lambda p: p.stat().st_mtime)
    linhas = []
    for l in arq.read_text(errors="replace").splitlines():
        try:
            e = json.loads(l)
        except ValueError:
            continue
        msg = e.get("message") or {}
        cont = msg.get("content")
        if e.get("type") == "user":
            if isinstance(cont, str):
                linhas.append(_t("**Usuário:** %1", cont))
            elif isinstance(cont, list):
                for b in cont:
                    if b.get("type") == "text":
                        linhas.append(_t("**Usuário:** %1", b.get('text', '')))
        elif e.get("type") == "assistant" and isinstance(cont, list):
            for b in cont:
                if b.get("type") == "text" and b.get("text", "").strip():
                    linhas.append(f"**Agente:** {b['text']}")
                elif b.get("type") == "tool_use":
                    inp = b.get("input") or {}
                    alvo = inp.get("command") or inp.get("file_path") or inp.get("path") or inp.get("pattern") or ""
                    linhas.append(f"- ferramenta `{b.get('name')}`: {_corta(alvo, 300)}")
    return linhas


def transcricao_codex(cwd, desde):
    arqs = [Path(p) for p in glob.glob(str(HOME / ".codex/sessions/**/rollout-*.jsonl"), recursive=True)]
    arqs = [p for p in arqs if p.stat().st_mtime >= desde - 5]
    if not arqs:
        return None
    arq = max(arqs, key=lambda p: p.stat().st_mtime)
    linhas = []
    for l in arq.read_text(errors="replace").splitlines():
        try:
            e = json.loads(l)
        except ValueError:
            continue
        p = e.get("payload") or {}
        if p.get("type") == "message":
            quem = _t("Usuário") if p.get("role") == "user" else _t("Agente")
            for b in p.get("content") or []:
                t = b.get("text", "")
                if t.strip() and not t.startswith("<environment_context>"):
                    linhas.append(f"**{quem}:** {t}")
        elif p.get("type") in ("function_call", "local_shell_call", "custom_tool_call"):
            linhas.append(f"- ferramenta `{p.get('name', p.get('type'))}`: {_corta(p.get('arguments') or p.get('input') or '', 300)}")
    return linhas


def tela_limpa(buf):
    """Texto do terminal sem códigos de cor/cursor, sem linhas repetidas seguidas."""
    t = ANSI.sub("", buf.decode("utf-8", "replace"))
    out, ant = [], None
    for l in t.splitlines():
        l = l.rstrip()
        if l and l != ant:
            out.append(l)
        ant = l
    return out


def passagem(agente, cwd, desde, tela, anterior=None):
    ESTADO.mkdir(parents=True, exist_ok=True)
    linhas = None
    try:
        if agente == "claude":
            linhas = transcricao_claude(cwd, desde)
        elif agente == "codex":
            linhas = transcricao_codex(cwd, desde)
    except Exception:  # noqa: BLE001
        linhas = None
    fonte = _t("transcrição da sessão")
    if not linhas:
        linhas = tela_limpa(tela)[-1500:]
        fonte = _t("texto que passou pelo terminal")
    texto = "\n\n".join(linhas) if fonte.startswith("transcrição") else "```\n" + "\n".join(linhas) + "\n```"
    # mantém o começo (o pedido) e o fim (onde parou)
    if len(texto) > 90000:
        texto = texto[:15000] + "\n\n[… parte do meio omitida …]\n\n" + texto[-70000:]
    git = ""
    if shutil.which("git"):
        r = subprocess.run(["git", "-C", str(cwd), "status", "--short"], capture_output=True, text=True, timeout=10)
        if r.returncode == 0:
            d = subprocess.run(["git", "-C", str(cwd), "diff", "--stat"], capture_output=True, text=True, timeout=10).stdout
            git = f"\n## Estado do Git em {cwd}\n\n```\n{r.stdout.strip() or '(sem mudanças)'}\n{d.strip()}\n```\n"
    ant = ""
    if anterior and Path(anterior).exists():
        ant = (f"\n## Passagem anterior\n\nEste trabalho já tinha passado por outro agente antes; o arquivo da passagem "
               f"anterior é `{anterior}` (leia se precisar do começo da história).\n")
    nome = AGENTES[agente]["nome"]
    arq = ESTADO / f"passagem-{datetime.now().strftime('%Y%m%d-%H%M%S')}.md"
    arq.write_text(f"""# Passagem de trabalho entre agentes

O {nome} estava fazendo este trabalho e **atingiu o limite de uso**. Você vai continuar.

- Pasta de trabalho: `{cwd}`
- Começou em: {datetime.fromtimestamp(desde).strftime('%d/%m/%Y %H:%M')}
- Fonte desta conversa: {fonte}
{ant}{git}
## Como continuar

1. Leia a conversa abaixo inteira: o primeiro pedido do usuário é a tarefa; as últimas
   mensagens mostram onde parou.
2. Confira no disco o que já foi feito (arquivos, comandos) antes de refazer qualquer coisa.
3. Continue exatamente de onde parou, no mesmo idioma do usuário, sem pedir para ele repetir.

## Conversa até agora

{texto}
""")
    return arq


# ── terminal ────────────────────────────────────────────────────────────────
def tamanho_terminal(fd):
    try:
        return fcntl.ioctl(fd, termios.TIOCGWINSZ, b"\0" * 8)
    except OSError:
        return struct.pack("HHHH", 40, 120, 0, 0)


def escrever(t):
    os.write(sys.stdout.fileno(), t.encode() if isinstance(t, str) else t)


def aviso(t, cor="1;33"):
    escrever(f"\r\n\x1b[0m\x1b[{cor}m▌ {t}\x1b[0m\r\n")


# Avisos de "quase lá" ("You've used 78% of your weekly limit · resets …") não são limite atingido
PARCIAL = re.compile(r"(used|usou|utilizou)\s+\d{1,2}(\.\d+)?\s*%|approaching|perto do limite|\b\d{1,2}% (of|do|da)\b", re.I)


def detectar_limite(texto):
    if FORTES.search(texto):
        return True
    return any(len(l.strip()) < 220 and LIMITE.search(l) and ACABOU.search(l) and not PARCIAL.search(l)
               for l in texto.splitlines())


def rodar(agente, pedido, cfg):
    """Roda o agente num pty. Devolve ("limite", tela, inicio) ou ("fim", codigo, inicio)."""
    info = AGENTES[agente]
    cmd = list(info["cmd"])
    if pedido:
        if info["prompt"]:
            cmd += [x.replace("{p}", pedido) for x in info["prompt"]]
        elif agente == "crush":
            cmd = ["crush", "run", pedido]
    inicio = time.time()
    pid, mestre = pty.fork()
    if pid == 0:
        os.environ["AGENTES_ATUAL"] = agente
        try:
            os.execvp(cmd[0], cmd)
        except OSError as e:
            print(_t("não foi possível abrir %1: %2", cmd[0], e))
            os._exit(127)
    fcntl.ioctl(mestre, termios.TIOCSWINSZ, tamanho_terminal(sys.stdin.fileno()))

    def redimensionar(*_):
        try:
            fcntl.ioctl(mestre, termios.TIOCSWINSZ, tamanho_terminal(sys.stdin.fileno()))
            os.kill(pid, signal.SIGWINCH)
        except OSError:
            pass
    signal.signal(signal.SIGWINCH, redimensionar)

    tela = bytearray()
    cauda = ""
    ignorar_ate = 0.0
    entrada = sys.stdin.fileno()
    while True:
        try:
            r, _, _ = select.select([mestre, entrada], [], [], 0.5)
        except InterruptedError:
            continue
        if mestre in r:
            try:
                dados = os.read(mestre, 65536)
            except OSError:
                dados = b""
            if not dados:
                break
            escrever(dados)
            tela += dados
            if len(tela) > 400000:
                del tela[:100000]
            if cfg["trocaAutomatica"] and time.time() >= ignorar_ate and time.time() - inicio > 2:
                novo = ANSI.sub("", dados.decode("utf-8", "replace"))
                cauda = (cauda + novo)[-600:]
                if detectar_limite(cauda):
                    if confirmar_troca(agente, cfg, entrada):
                        encerrar(pid)
                        os.close(mestre)
                        return "limite", bytes(tela), inicio
                    ignorar_ate = time.time() + 120
                    cauda = ""
        if entrada in r:
            try:
                d = os.read(entrada, 4096)
            except OSError:
                d = b""
            if d:
                os.write(mestre, d)
    _, st = os.waitpid(pid, 0)
    os.close(mestre)
    return "fim", os.waitstatus_to_exitcode(st), inicio


def confirmar_troca(agente, cfg, entrada):
    proximo = [a for a in candidatos(cfg, pular={agente}) if not esgotado_ate(a)]
    nome = AGENTES[agente]["nome"]
    if not proximo:
        aviso(_t("Parece que o limite do %1 acabou, mas não há outro agente disponível na lista (Configurações › Agentes de IA).", nome))
        return False
    seg = max(0, int(cfg.get("esperar", 8)))
    alvo = AGENTES[proximo[0]]["nome"]
    for s in range(seg, -1, -1):
        escrever(_t("\r\u001b[0m\u001b[2K\u001b[1;33m▌ Limite do %1 atingido — trocando para o %2 com o contexto em %3 s \u001b[0m(Enter troca já · Esc continua no %4)", nome, alvo, s, nome))
        if s == 0:
            break
        r, _, _ = select.select([entrada], [], [], 1)
        if entrada in r:
            d = os.read(entrada, 64)
            if d in (b"\r", b"\n"):
                break
            if d.startswith(b"\x1b") or d.lower() in (b"n", b"c"):
                escrever("\r\x1b[2K")
                aviso(_t("Continuando no %1.", nome), "2")
                return False
    escrever("\r\n")
    return True


def encerrar(pid):
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(os.getpgid(pid), sig)
        except OSError:
            try:
                os.kill(pid, sig)
            except OSError:
                return
        for _ in range(20):
            p, _ = os.waitpid(pid, os.WNOHANG)
            if p:
                return
            time.sleep(0.1)


def sessao(pedido):
    cfg = ler_config()
    cwd = Path.cwd()
    if cwd == HOME and (HOME / "Work").is_dir():
        os.chdir(HOME / "Work")
        cwd = HOME / "Work"
    lista = candidatos(cfg)
    if not lista:
        print(_t("Nenhum agente de IA disponível. Abra Configurações › Agentes de IA para escolher e entrar nas contas."))
        return 1
    pulados = []
    for a in list(lista):
        ate = esgotado_ate(a)
        if ate and len(lista) > 1:
            pulados.append(_t("%1 (sem limite até %2)", AGENTES[a]['nome'], hora(ate)))
            lista.remove(a)
    antigo = termios.tcgetattr(sys.stdin.fileno()) if sys.stdin.isatty() else None
    usados, anterior = set(), None
    agente = lista[0]
    if pulados:
        aviso(_t("Pulando: ") + ", ".join(pulados), "2")
    try:
        if antigo:
            tty.setraw(sys.stdin.fileno())
        while True:
            usados.add(agente)
            resultado, extra, inicio = rodar(agente, pedido, cfg)
            if resultado != "limite":
                return extra
            marcar_esgotado(agente)
            arq = passagem(agente, cwd, inicio, extra, anterior)
            anterior = arq
            seguintes = [a for a in candidatos(cfg, pular=usados) if not esgotado_ate(a)]
            if not seguintes:
                aviso(_t("Todos os agentes da lista estão sem limite agora. O contexto ficou salvo em ") + str(arq))
                return 1
            novo = seguintes[0]
            aviso(_t("%1 → %2: contexto salvo em %3", AGENTES[agente]['nome'], AGENTES[novo]['nome'], arq), "1;36")
            subprocess.run(["notify-send", "-a", _t("Agentes de IA"), "-i", "dialog-information",
                            _t("Trocando para o %1", AGENTES[novo]['nome']),
                            _t("O limite do %1 acabou; o trabalho continua com o contexto.", AGENTES[agente]['nome'])],
                           capture_output=True)
            pedido = (_t("Você vai continuar um trabalho que outro agente de IA (%1) começou e não terminou porque o limite de uso dele acabou. Leia primeiro, por inteiro, o arquivo %2 (pedido do usuário, conversa, comandos e estado do Git). Depois confira o que já foi feito e continue exatamente de onde parou, sem pedir para o usuário repetir nada.", AGENTES[agente]['nome'], arq))
            agente = novo
    finally:
        if antigo:
            termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, antigo)


# ── comandos para a página de Configurações ─────────────────────────────────
# ── instalar / remover ──────────────────────────────────────────────────────
def _mise_linha(ferramenta, valor):
    """Põe (ou troca) `ferramenta = valor` em [tools] do config.toml global do mise."""
    linhas = MISE_CONFIG.read_text(encoding="utf-8").splitlines() if MISE_CONFIG.exists() else []
    nova = f"{ferramenta} = {valor}"
    secao, ini, fim, achou = None, None, None, False
    for i, l in enumerate(linhas):
        t = l.strip()
        if t.startswith("["):
            if secao == "[tools]" and fim is None:
                fim = i
            secao = t.replace(" ", "")
            if secao == "[tools]":
                ini = i
            continue
        if secao == "[tools]" and "=" in t and t.split("=", 1)[0].strip().strip('"') == ferramenta:
            linhas[i], achou = nova, True
    if not achou:
        if ini is None:
            linhas = ["[tools]", nova, ""] + linhas
        else:
            if fim is None:
                fim = len(linhas)
            while fim > ini + 1 and not linhas[fim - 1].strip():
                fim -= 1
            linhas.insert(fim, nova)
    MISE_CONFIG.parent.mkdir(parents=True, exist_ok=True)
    tmp = MISE_CONFIG.with_suffix(".toml.tmp")
    tmp.write_text("\n".join(linhas) + "\n", encoding="utf-8")
    tmp.replace(MISE_CONFIG)


def _avisar(titulo, texto, erro=False):
    subprocess.run(["notify-send", "-a", _t("Agentes de IA"), "-i", "dialog-error" if erro else "emblem-ok-symbolic",
                    titulo, texto], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def _instalando(a):
    """Instalação em andamento (a marca existe e o processo que a criou ainda roda)."""
    marca = ESTADO / f"instalando-{a}"
    try:
        os.kill(int(marca.read_text()), 0)
        return True
    except (OSError, ValueError):
        marca.unlink(missing_ok=True)
        return False


def instalar(a):
    """Baixa e instala sem perguntar nada; o arquivo instalando-<id> mostra o progresso na página."""
    info, nome = INSTALAR[a], AGENTES[a]["nome"]
    ESTADO.mkdir(parents=True, exist_ok=True)
    marca = ESTADO / f"instalando-{a}"
    marca.write_text(str(os.getpid()))
    log = ESTADO / f"instalar-{a}.log"
    ok = False
    try:
        with open(log, "w") as saida:
            if "mise" in info:
                _mise_linha(a, info["mise"])
                env = dict(os.environ, MISE_YES="1")
                ok = subprocess.run(["mise", "install", a], stdout=saida, stderr=subprocess.STDOUT, env=env,
                                    stdin=subprocess.DEVNULL).returncode == 0
                subprocess.run(["mise", "reshim"], stdout=saida, stderr=subprocess.STDOUT)
            else:
                script = ESTADO / f"instalar-{a}.sh"
                ok = subprocess.run(["curl", "-fsSL", "-o", str(script), info["script"]], stdout=saida,
                                    stderr=subprocess.STDOUT).returncode == 0
                ok = ok and subprocess.run(["bash", str(script)], stdout=saida, stderr=subprocess.STDOUT,
                                           stdin=subprocess.DEVNULL).returncode == 0
                script.unlink(missing_ok=True)
                ok = ok and Path(info["bin"]).exists()
        ok = ok and bool(_achar(a))
    finally:
        marca.unlink(missing_ok=True)
    if ok:
        c = ler_config()
        if a not in c["ordem"]:
            c["ordem"].append(a)
        if a in c["inativos"]:
            c["inativos"].remove(a)
        gravar_config(c)
        _avisar(_t("Agente instalado"), nome + " " + _t("está pronto. Clique em Entrar para conectar sua conta."))
    else:
        _avisar(_t("Não deu para instalar") + " " + nome, _t("Verifique a internet e tente de novo."), erro=True)
    return 0 if ok else 1


def remover(a):
    info = INSTALAR[a]
    if "mise" in info:
        ok = subprocess.run(["mise", "unuse", "-g", a], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                            stdin=subprocess.DEVNULL, env=dict(os.environ, MISE_YES="1")).returncode == 0
        subprocess.run(["mise", "reshim"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        try:
            Path(info["bin"]).unlink(missing_ok=True)
            ok = True
        except OSError:
            ok = False
    if ok:
        c = ler_config()
        if a in c["ordem"]:
            c["ordem"].remove(a)
        if a in c["inativos"]:
            c["inativos"].remove(a)
        gravar_config(c)
    return 0 if ok else 1


def estado():
    c = ler_config()
    out = []
    for a in c["ordem"] + [x for x in AGENTES if x not in c["ordem"]]:
        if a not in AGENTES:
            continue
        inst = bool(_achar(a))
        ate = esgotado_ate(a) if inst else None
        icone = f"/usr/share/simba/shell/plugins/agents/assets/{a}.svg"
        out.append({"id": a, "nome": AGENTES[a]["nome"], "instalado": inst, "conectado": conectado(a) if inst else False,
                    "instalavel": a in INSTALAR, "sobre": _t(INSTALAR.get(a, {}).get("sobre", "")),
                    "instalando": _instalando(a),
                    "ativo": a not in c["inativos"] and a in c["ordem"], "uso": uso(a), "esgotadoAte": ate,
                    "esgotadoTexto": hora(ate) if ate else "", "icone": icone if os.path.exists(icone) else ""})
    return {"agentes": out, "trocaAutomatica": c["trocaAutomatica"], "esperar": c["esperar"]}


def main():
    a = sys.argv[1:]
    if a and a[0] in ("-h", "--help", "ajuda"):
        print(__doc__)
        return 0
    if not a:
        return sessao(None)
    if a[0] == "--prompt" and len(a) > 1:
        return sessao(" ".join(a[1:]))
    if a[0] == "abrir":
        os.execvp("simba-launch-tui", ["simba-launch-tui", "--app-id=org.simba.agent", str(Path(__file__).resolve())])
    c = ler_config()
    if a[0] == "estado":
        print(json.dumps(estado(), ensure_ascii=False))
    elif a[0] == "ordem":
        c["ordem"] = [x for x in a[1:] if x in AGENTES] + [x for x in c["ordem"] if x not in a[1:]]
        gravar_config(c)
    elif a[0] == "ativar" and len(a) == 3:
        if a[2] == "1":
            c["inativos"] = [x for x in c["inativos"] if x != a[1]]
            if a[1] not in c["ordem"]:
                c["ordem"].append(a[1])
        elif a[1] not in c["inativos"]:
            c["inativos"].append(a[1])
        gravar_config(c)
    elif a[0] == "opcao" and len(a) == 3:
        c[a[1]] = json.loads(a[2])
        gravar_config(c)
    elif a[0] == "instalar" and len(a) == 2 and a[1] in INSTALAR:
        return instalar(a[1])
    elif a[0] == "remover" and len(a) == 2 and a[1] in INSTALAR:
        return remover(a[1])
    elif a[0] == "entrar" and len(a) == 2 and a[1] in AGENTES:
        login = " ".join(AGENTES[a[1]]["login"])
        nome = AGENTES[a[1]]["nome"]
        subprocess.Popen(["simba-launch-tui", "--app-id=org.simba.agent", "bash", "-c",
                          f"echo 'Entrar no {nome}…'; {login}; rm -f '{ESTADO}/login-{a[1]}'; echo; "
                          "read -n1 -rsp '" + _t("Pronto. Tecle algo para fechar.") + "'"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    else:
        print(__doc__, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
