#!/bin/bash

# simba:summary=Log out after closing application windows
# simba:examples=simba logout | simba system logout
# simba:aliases=simba logout

nohup bash -c "sleep 2 && uwsm stop" >/dev/null 2>&1 &

simba-osd -i logout -m "Logging out" -d 5000

# Now close all windows
simba-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
