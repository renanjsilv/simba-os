[Unit]
Description=Botões de janela do Simba (ligados)
# Só uma marca: o componente roda dentro das Configurações (qs -c configuracoes,
# /etc/xdg/quickshell/botoes-janela/BotoesJanela.qml), que o carrega quando este
# serviço está habilitado. Ligar/desligar: Configurações › Janelas.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/true

[Install]
WantedBy=graphical-session.target
