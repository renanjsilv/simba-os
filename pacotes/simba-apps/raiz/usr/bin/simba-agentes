#!/bin/bash
# Agentes de IA do Simba OS (Frontend unificado GTK4/libadwaita).

# Suporte ao modo toggle (ex.: atalho global de teclado):
if [[ "$1" == "--toggle" ]]; then
  info=$(hyprctl clients -j 2>/dev/null | jq -r '.[] | select(.class=="com.simba.Agentes") | "\(.address) \(.workspace.name) \(.fullscreen)"' | head -1)
  if [[ -n $info ]]; then
    read -r addr ws fs <<<"$info"
    focado=$(hyprctl activewindow -j 2>/dev/null | jq -r .address)
    atual=$(hyprctl activeworkspace -j 2>/dev/null | jq -r .name)
    if [[ "$addr" == "$focado" ]]; then
      hyprctl dispatch movetoworkspacesilent "special:agentes,address:$addr" >/dev/null 2>&1
      exit 0
    else
      [[ -n $atual && $ws != "$atual" ]] && hyprctl dispatch "hl.dsp.window.move({ workspace = \"$atual\", follow = false, window = \"address:$addr\" })" >/dev/null 2>&1
      [[ ${fs:-0} == 0 ]] && hyprctl dispatch "janelas.maximizar(\"$addr\")" >/dev/null 2>&1
      hyprctl dispatch "foco.janela(\"$addr\")" >/dev/null 2>&1
      exit 0
    fi
  fi
  shift
fi

# Já aberto e sem argumentos novos: traz a janela para a área de trabalho atual, maximiza e foca.
if [[ $# -eq 0 ]]; then
  info=$(hyprctl clients -j 2>/dev/null | jq -r '.[] | select(.class=="com.simba.Agentes") | "\(.address) \(.workspace.name) \(.fullscreen)"' | head -1)
  if [[ -n $info ]]; then
    read -r addr ws fs <<<"$info"
    atual=$(hyprctl activeworkspace -j 2>/dev/null | jq -r .name)
    [[ -n $atual && $ws != "$atual" ]] && hyprctl dispatch "hl.dsp.window.move({ workspace = \"$atual\", follow = false, window = \"address:$addr\" })" >/dev/null 2>&1
    [[ ${fs:-0} == 0 ]] && hyprctl dispatch "janelas.maximizar(\"$addr\")" >/dev/null 2>&1
    hyprctl dispatch "foco.janela(\"$addr\")" >/dev/null 2>&1
    exit 0
  fi
fi

exec /usr/bin/python3 /usr/share/simba-apps/agentes/app.py "$@"
