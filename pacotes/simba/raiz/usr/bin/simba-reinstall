#!/bin/bash

# simba:summary=Reinstall Simba packages and reset default configs
# simba:requires-sudo=true

set -e

echo -e "This will reinstall all default Simba packages and reset default configs.\nWarning: user config changes will be overwritten.\n"

if gum confirm "Are you sure you want to reinstall and lose config changes?"; then
  simba-reinstall-pkgs
  simba-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && simba-system-reboot
fi
