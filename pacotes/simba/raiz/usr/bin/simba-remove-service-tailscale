#!/bin/bash

# simba:summary=Remove Tailscale and its bar plugin.
# simba:requires-sudo=true

tailscale down 2>/dev/null || true
systemctl --user disable --now simba-tailscale-receive.service 2>/dev/null || true
sudo systemctl disable --now tailscaled.service 2>/dev/null || true
simba-plugin-disable simba.tailscale
simba-webapp-remove "Tailscale" 2>/dev/null || true
simba-pkg-drop tailscale

echo ""
echo "Tailscale has been removed."
