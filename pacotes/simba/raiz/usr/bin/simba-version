#!/bin/bash

# simba:summary=Print the installed Simba version

simba_path=${SIMBA_PATH:-/usr/share/simba}
simba_path=${simba_path%/}

if [[ $simba_path != "/usr/share/simba" ]]; then
  hash=$(git -C "$simba_path" rev-parse --short HEAD 2>/dev/null || true)

  if [[ -n $hash ]]; then
    echo "dev ($hash)"
  else
    echo "dev"
  fi

  exit 0
fi

# The edge channel installs simba-dev instead of simba, so check both.
for package in simba-dev simba; do
  version=$(pacman -Q "$package" 2>/dev/null | awk '{ print $2 }')
  [[ -n $version ]] && break
done

[[ -n $version ]] || exit 1

echo "$version"
