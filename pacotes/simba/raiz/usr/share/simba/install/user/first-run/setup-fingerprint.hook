#!/bin/bash

set -e

# Only invite when there's a reader to use and it isn't set up yet (the lock
# PAM file is the last thing the setup writes on success).
if simba-hw-fingerprint && [[ ! -f /etc/pam.d/simba-lock-fingerprint ]] &&
  simba-done ensure fingerprint-setup-invitation; then
  simba-notification-send -u critical -g 󰈷 "Setup Fingerprint Reader" \
    "Enable sudo and unlocking with your fingerprint." \
    --exec simba-launch-floating-terminal-with-presentation simba-setup-security-fingerprint
fi
