#!/bin/bash

# simba:summary=Select and set the system timezone
# simba:group=menu
# simba:name=timezone

set -e

timezone=$(timedatectl list-timezones | simba-menu-select "Set timezone" -- --width 520 --maxheight 520) || exit 1
sudo timedatectl set-timezone "$timezone"
simba-shell -q simba.clock refresh
simba-notification-send "Fuso horário definido como $timezone"
