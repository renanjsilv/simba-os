#!/bin/bash

# simba:summary=Launch a TUI or focus an existing terminal window for it
# simba:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.simba.$(basename "$1")"
fi

LAUNCH_COMMAND="simba-launch-tui $@"

exec simba-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
