#!/bin/bash
# publicar — constrói o que mudou, assina e envia para o CANAL DE TESTE ([simba-os-testing],
# release "repo-testing"). Teste numa VM ou máquina com `simba-canal teste` e, se estiver tudo
# certo, leve os mesmos arquivos para todo mundo com `ferramentas/promover`.
#
#   publicar            → canal de teste
#   publicar --direto   → direto para o [simba-os] (só emergência: correção de segurança etc.)
#
# PUBLICAR_SEM_CONSTRUIR=1: publica os pacotes já construídos e assinados em dist/ (sem
# recompilar, o que trocaria os arquivos e pediria a senha da chave de novo)
set -euo pipefail
R="$(cd "$(dirname "$0")/.." && pwd)"
source "$R/ferramentas/config.sh"
source "$R/ferramentas/repo.sh"
checar_gh
# pacotes do AUR republicados com versão nova (ex.: correção de segurança do Brave): só avisa
if ! atrasados=$("$R/ferramentas/verificar-aur" --silencioso); then
  printf 'AVISO: receitas do AUR atrasadas — atualize e construa antes de publicar:\n%s\n' "$atrasados" >&2
fi
[[ -n ${PUBLICAR_SEM_CONSTRUIR:-} ]] || "$R/ferramentas/construir"
if [[ ${1:-} == --direto ]]; then
  echo "ATENÇÃO: publicando direto no canal estável, sem passar pelo teste" >&2
  enviar_repo "$RELEASE_TAG" "$REPO_NOME" "$R/dist"
else
  enviar_repo "$TESTE_TAG" "$TESTE_NOME" "$R/dist"
  echo "Teste com 'simba-canal teste' + 'Atualizar tudo'; depois: ferramentas/promover"
fi
