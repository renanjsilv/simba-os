#!/bin/bash

# simba:summary=Finalize Simba user setup (runtime tweaks /etc/skel can't do)
# simba:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: simba finalize user [--force] [--first-install]

Runs the per-user setup steps that /etc/skel can't seed:
dev-aware skill symlinks, xdg-user-dirs + gtk bookmarks (need \$HOME),
default browser/mailto, and install/user/all.sh.

For shipped configs see /etc/skel (new users) and simba-reinstall-configs
(existing users explicitly resyncing).

--first-install is used by the ISO in the target chroot. It marks shipped
migrations complete for the freshly-created user.

Idempotency marker: ~/.local/state/simba/done/finalize-user
USAGE
}

if (( EUID == 0 )); then
  echo "Error: run simba-provision-user as the user being configured, not as root." >&2
  exit 1
fi

force=0
first_install=0
while (($#)); do
  case "$1" in
    --force)
      force=1
      shift
      ;;
    --first-install)
      first_install=1
      force=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

state_dir="$HOME/.local/state/simba"
mkdir -p "$state_dir"

if simba-done check finalize-user && (( force == 0 )); then
  echo "User finalization already complete (rerun with --force to refresh)."
  exit 0
fi

export SIMBA_PATH="${SIMBA_PATH:-/usr/share/simba}"
export SIMBA_INSTALL="${SIMBA_INSTALL:-$SIMBA_PATH/install}"
export SIMBA_SETUP_CONTEXT="${SIMBA_SETUP_CONTEXT:-runtime}"
export PATH="$SIMBA_PATH/bin:$PATH"

if (( first_install )) && [[ $SIMBA_SETUP_CONTEXT == "runtime" ]]; then
  # The ISO chroot doesn't set a context; simba-provision-owner runs first-install
  # finalization too but with SIMBA_SETUP_CONTEXT=provision-owner already set.
  export SIMBA_SETUP_CONTEXT=iso-chroot
fi

if [[ -n ${SIMBA_INSTALL_LOG_FILE:-} && -f $SIMBA_INSTALL/helpers/logging.sh ]]; then
  source "$SIMBA_INSTALL/helpers/logging.sh"
else
  run_logged() {
    local script="$1"
    bash -eE -c 'source "$1"' bash "$script"
  }
fi

# Dev-aware skill symlinks. Cannot live in /etc/skel because SIMBA_PATH may
# point at a dev checkout (simba dev link) where the target differs.
# Loops every skill directory, so shipping a new one needs no edit here.
mkdir -p ~/.agents/skills ~/.claude/skills ~/.codex/skills ~/.pi/agent/skills ~/.hermes/skills
for skill in "$SIMBA_PATH"/default/agents/skills/*/; do
  skill=${skill%/}
  name=${skill##*/}
  ln -sfn "$skill" ~/.agents/skills/"$name"
  ln -sfn "$skill" ~/.claude/skills/"$name"
  ln -sfn "$skill" ~/.codex/skills/"$name"
  ln -sfn "$skill" ~/.pi/agent/skills/"$name"
  ln -sfn "$skill" ~/.hermes/skills/"$name"
  if [[ -d ~/.hermes/profiles ]]; then
    for profile in ~/.hermes/profiles/*/; do
      [[ -d $profile ]] || continue
      mkdir -p "$profile/skills"
      ln -sfn "$skill" "$profile/skills/$name"
    done
  fi
done

# Simba: as pastas do usuário seguem o ~/.config/user-dirs.dirs (nomes em português, com
# uma Área de Trabalho de verdade — a área de trabalho do Simba mostra os ícones dela)
mkdir -p ~/.config/gtk-3.0
xdg-user-dirs-update
touch ~/.config/gtk-3.0/bookmarks
for tipo in DOWNLOAD DOCUMENTS PICTURES VIDEOS; do
  dir=$(xdg-user-dir "$tipo")
  [[ -n $dir && $dir != "$HOME" ]] || continue
  mkdir -p "$dir"
  bookmark="file://$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1]))' "$dir") $(basename "$dir")"
  grep -qxF "$bookmark" ~/.config/gtk-3.0/bookmarks || echo "$bookmark" >>~/.config/gtk-3.0/bookmarks
done

source "$SIMBA_INSTALL/user/all.sh"

simba-refresh-applications
env -u BROWSER XDG_CURRENT_DESKTOP= xdg-settings set default-web-browser brave-browser.desktop

if (( first_install )); then
  mkdir -p "$state_dir/migrations"
  for migration in "$SIMBA_PATH"/migrations/*.sh; do
    [[ -f $migration ]] && touch "$state_dir/migrations/$(basename "$migration")"
  done
fi

simba-done mark finalize-user
echo "User finalization complete."
