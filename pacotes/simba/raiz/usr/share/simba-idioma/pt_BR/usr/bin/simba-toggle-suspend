#!/bin/bash

# simba:summary=Toggle suspend availability in the system menu

simba-toggle suspend-off

if simba-toggle-enabled suspend-off; then
  simba-notification-send -g 󰒲 "Suspender removido do menu do sistema"
else
  simba-notification-send -g 󰒲 "Suspender agora disponível no menu do sistema"
fi
