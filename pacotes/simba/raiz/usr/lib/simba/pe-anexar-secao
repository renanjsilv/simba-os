#!/usr/bin/env python3
"""pe-anexar-secao <entrada.efi> <saída.efi> <nome> <arquivo> — acrescenta uma seção a um PE/COFF
(ex.: .sbat no Limine, exigida pelo shim) sem mexer em nada do que já existe: cabeçalhos,
seções e tamanhos virtuais ficam iguais; a seção nova vai depois da última, alinhada."""
import struct, sys
src, dst, nome, arq = sys.argv[1:5]
d = bytearray(open(src, "rb").read()); dados = open(arq, "rb").read()
pe = struct.unpack_from("<I", d, 0x3C)[0]
assert d[pe:pe + 4] == b"PE\0\0", "não é PE"
coff = pe + 4
nsec, = struct.unpack_from("<H", d, coff + 2)
opt_size, = struct.unpack_from("<H", d, coff + 16)
opt = coff + 20
magic, = struct.unpack_from("<H", d, opt)
assert magic == 0x20B, "esperado PE32+"
sec_align, file_align = struct.unpack_from("<II", d, opt + 32)
size_headers, = struct.unpack_from("<I", d, opt + 60)
# diretório de segurança (assinatura) precisa estar vazio: assinar só depois
cert_rva, cert_size = struct.unpack_from("<II", d, opt + 112 + 4 * 8)
assert cert_size == 0, "binário já assinado: anexe a seção antes de assinar"
tab = opt + opt_size
for i in range(nsec):
    n = d[tab + 40 * i: tab + 40 * i + 8].rstrip(b"\0").decode()
    assert n != nome, f"já tem {nome}"
novo = tab + 40 * nsec
assert novo + 40 <= size_headers, "sem espaço para mais um cabeçalho de seção"
fim_v = fim_f = 0
for i in range(nsec):
    vsz, va, rsz, rptr = struct.unpack_from("<IIII", d, tab + 40 * i + 8)
    fim_v = max(fim_v, va + max(vsz, rsz)); fim_f = max(fim_f, rptr + rsz)
al = lambda x, a: (x + a - 1) // a * a
va = al(fim_v, sec_align); rptr = al(max(fim_f, len(d)), file_align); rsz = al(len(dados), file_align)
d += b"\0" * (rptr - len(d)) + dados + b"\0" * (rsz - len(dados))
struct.pack_into("<8sIIIIIIHHI", d, novo, nome.encode()[:8], len(dados), va, rsz, rptr, 0, 0, 0, 0,
                 0x40000040)   # CNT_INITIALIZED_DATA | MEM_READ
struct.pack_into("<H", d, coff + 2, nsec + 1)
struct.pack_into("<I", d, opt + 56, al(va + len(dados), sec_align))   # SizeOfImage
struct.pack_into("<I", d, opt + 64, 0)                                # CheckSum (opcional)
open(dst, "wb").write(d)
